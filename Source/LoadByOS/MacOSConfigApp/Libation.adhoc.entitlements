<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Ad-hoc signatures have no shared Team ID, so hardened-runtime library validation
       would reject the self-contained .NET runtime before Libation can start. The
       Developer ID path deliberately uses Libation.entitlements instead. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
