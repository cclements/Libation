<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:onboarding="using:LibationAvalonia.Features.Onboarding"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:designSystem="using:LibationAvalonia.DesignSystem"
	xmlns:experience="using:LibationFileManager"
	xmlns:properties="using:LibationAvalonia.Properties"
	x:Class="LibationAvalonia.Features.Onboarding.OnboardingView"
	x:DataType="onboarding:OnboardingViewModel">
	<Grid RowDefinitions="*,Auto">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="{DynamicResource Libation.Thickness.5}" Spacing="{DynamicResource Libation.Space.4}">
				<components:PageHeader Eyebrow="{x:Static properties:Resources.OnboardingViewWelcomeToLibation}" Title="{Binding StepTitle}"
					SupportingText="{x:Static properties:Resources.OnboardingSupportingText}" />
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Text="{Binding StepSummary}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<TextBlock Grid.Column="1" Text="{Binding SelectedProfileText}" FontWeight="SemiBold"
							Foreground="{DynamicResource Libation.Brush.AccentSecondary}" />
					</Grid>
					<ProgressBar Classes="contemporary prominent" Minimum="0" Maximum="100" Value="{Binding Progress}"
						AutomationProperties.Name="{x:Static properties:Resources.OnboardingViewOnboardingProgress}" />
				</StackPanel>

				<components:AttentionBanner IsVisible="{Binding HasError}" Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
					Title="{x:Static properties:Resources.OnboardingViewSetupActionUnavailable}" Message="{Binding ErrorMessage}"
					ActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}" ActionCommand="{Binding CopyTechnicalDetailsCommand}" />

				<StackPanel IsVisible="{Binding IsWelcomeStep}" Spacing="{DynamicResource Libation.Space.3}">
					<TextBlock Text="{x:Static properties:Resources.OnboardingWelcomeBody}"
						TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
					<TextBlock Text="{Binding ProfileChoiceHelpText}" TextWrapping="Wrap"
						Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					<components:AttentionBanner IsVisible="{Binding NeedsExplicitProfileChoice}"
						Severity="{x:Static components:ComponentSeverity.Warning}"
						Title="{x:Static properties:Resources.OnboardingViewChooseAProfileBeforeContinuing}"
						Message="{x:Static properties:Resources.OnboardingProfileChoiceWarning}" />
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}"
						RowSpacing="{DynamicResource Libation.Space.3}">
						<onboarding:ProfileChoicePreview ProfileStyle="{x:Static experience:ExperienceStyle.FollowSystem}"
							ProfileName="{x:Static properties:Resources.OnboardingViewFollowSystem}" Description="{x:Static properties:Resources.OnboardingViewUsesTheOperatingSystemAppearanceWhileKeeping}"
							ActionText="{x:Static properties:Resources.OnboardingViewChooseFollowSystem}" SelectCommand="{Binding SelectFollowSystemCommand}"
							IsSelected="{Binding IsFollowSystemSelected}" />
						<onboarding:ProfileChoicePreview Grid.Column="1" ProfileStyle="{x:Static experience:ExperienceStyle.Cellar}"
							ProfileName="{x:Static properties:Resources.OnboardingViewCellar}" Description="{x:Static properties:Resources.OnboardingViewWarmQuietCollectionFirstPresentationForFocused}"
							ActionText="{x:Static properties:Resources.OnboardingViewChooseCellar}" SelectCommand="{Binding SelectCellarCommand}"
							IsSelected="{Binding IsCellarSelected}" />
						<onboarding:ProfileChoicePreview Grid.Row="1" ProfileStyle="{x:Static experience:ExperienceStyle.TastingRoom}"
							ProfileName="{x:Static properties:Resources.OnboardingViewTastingRoom}" Description="{x:Static properties:Resources.OnboardingViewABrighterEditorialPresentationWithTheSame}"
							ActionText="{x:Static properties:Resources.OnboardingViewChooseTastingRoom}" SelectCommand="{Binding SelectTastingRoomCommand}"
							IsSelected="{Binding IsTastingRoomSelected}" />
						<onboarding:ProfileChoicePreview Grid.Row="1" Grid.Column="1"
							ProfileStyle="{x:Static experience:ExperienceStyle.CurrentAvalonia}"
							ProfileName="{x:Static properties:Resources.OnboardingViewCurrentLibationInterface}"
							Description="{x:Static properties:Resources.OnboardingViewKeepsTheCurrentLibationDesktopInterfaceThis}"
							ActionText="{x:Static properties:Resources.OnboardingViewKeepCurrentInterface}" SelectCommand="{Binding SelectCurrentInterfaceCommand}"
							IsSelected="{Binding IsCurrentInterfaceSelected}" />
						<onboarding:ProfileChoicePreview Grid.Row="2" Grid.ColumnSpan="2"
							ProfileStyle="{x:Static experience:ExperienceStyle.HighContrast}"
							ProfileName="{x:Static properties:Resources.OnboardingViewHighContrast}"
							Description="{x:Static properties:Resources.OnboardingHighContrastDescription}"
							ActionText="{x:Static properties:Resources.OnboardingViewChooseHighContrast}" SelectCommand="{Binding SelectHighContrastCommand}"
							IsSelected="{Binding IsHighContrastSelected}" />
					</Grid>
				</StackPanel>

				<Border Classes="card raised" IsVisible="{Binding IsAccountStep}">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.4}">
						<StackPanel Spacing="{DynamicResource Libation.Space.2}">
							<TextBlock Text="{x:Static properties:Resources.OnboardingViewAccountsStayPrivate}" FontFamily="{DynamicResource Libation.Font.Display}"
								FontSize="{DynamicResource Libation.FontSize.Section}" />
							<TextBlock Text="{Binding AccountStateText}" FontWeight="SemiBold" />
							<TextBlock Text="{x:Static properties:Resources.OnboardingAccountPrivacy}"
								TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Classes="contemporary primary" Content="{x:Static properties:Resources.AccountsViewAddAccount}" Command="{Binding AddAccountCommand}" />
								<Button Classes="contemporary" Content="{x:Static properties:Resources.OnboardingViewManageAccounts}" Command="{Binding ManageAccountsCommand}" />
							</StackPanel>
						</StackPanel>
						<ContentControl Grid.Column="1" Width="180" Height="120"
							Template="{StaticResource illustration.shared.account-connection}"
							IsVisible="{DynamicResource Libation.Decoration.Visible}"
							Opacity="{DynamicResource Libation.Decoration.Opacity}"
							AutomationProperties.IsControlElementOverride="False" />
					</Grid>
				</Border>

				<Border Classes="card raised" IsVisible="{Binding IsLocationStep}">
					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<TextBlock Text="{x:Static properties:Resources.OnboardingViewKeepOriginalsAndConvertedFilesWhereYou}" FontFamily="{DynamicResource Libation.Font.Display}"
							FontSize="{DynamicResource Libation.FontSize.Section}" />
						<TextBlock Text="{Binding LocationStateText}" TextWrapping="Wrap" />
						<TextBlock Text="{x:Static properties:Resources.OnboardingLocationExplanation}"
							TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<TextBlock Text="{x:Static properties:Resources.OnboardingStorageReminder}"
							TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Classes="contemporary primary" Content="{x:Static properties:Resources.OnboardingViewOpenSettings}" Command="{Binding OpenSettingsCommand}" />
							<Button Classes="contemporary" Content="{x:Static properties:Resources.OnboardingViewLocateExistingFiles}" Command="{Binding LocateFilesCommand}" />
						</StackPanel>
					</StackPanel>
				</Border>

				<Border Classes="card raised" IsVisible="{Binding IsScanStep}">
					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.OnboardingViewBringYourLibraryIntoView}" FontFamily="{DynamicResource Libation.Font.Display}"
									FontSize="{DynamicResource Libation.FontSize.Section}" />
								<TextBlock Text="{Binding ScanStateText}" TextWrapping="Wrap" />
							</StackPanel>
							<components:StatusBadge Grid.Column="1" Status="{Binding ScanStatus}"
								TextOverride="{Binding ScanStageText}" AccessibleName="{Binding ScanProgressAccessibleName}" />
						</Grid>
						<ProgressBar IsVisible="{Binding IsScanning}" IsIndeterminate="True"
							AutomationProperties.Name="{Binding ScanProgressAccessibleName}"
							AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}" />
						<TextBlock Text="{x:Static properties:Resources.OnboardingScanExplanation}"
							TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<Button Classes="contemporary primary" Content="{x:Static properties:Resources.OnboardingViewScanAllAccounts}" Command="{Binding ScanCommand}"
							IsEnabled="{Binding CanStartScan}" HorizontalAlignment="Left"
							AutomationProperties.HelpText="{x:Static properties:Resources.OnboardingViewStartsTheExistingNonblockingAccountScanYou}" />
					</StackPanel>
				</Border>

				<Border Classes="card raised" IsVisible="{Binding IsFirstFlightStep}">
					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Libation.Space.3}">
							<Path Data="{StaticResource glyph.flight}" Width="32" Height="32" Stretch="Uniform"
								Stroke="{DynamicResource Libation.Brush.AccentSecondary}" StrokeThickness="1.5" />
							<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.OnboardingViewCurrentFlightStaysIntentional}" FontFamily="{DynamicResource Libation.Font.Display}"
									FontSize="{DynamicResource Libation.FontSize.Section}" />
								<TextBlock Text="{x:Static properties:Resources.OnboardingFlightExplanation}"
									TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
								<TextBlock Text="{x:Static properties:Resources.OnboardingStatusExplanation}"
									TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
								<TextBlock Text="{Binding FirstFlightStateText}"
									TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
								<TextBlock Text="{Binding LocationStateText}" TextWrapping="Wrap"
									Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
							</StackPanel>
						</Grid>
					<Button Classes="contemporary primary" Content="{Binding FirstFlightActionText}"
						Command="{Binding AddNewestToFlightCommand}" IsEnabled="{Binding CanShowFirstFlightAction}"
							HorizontalAlignment="Left"
							AutomationProperties.Name="{x:Static properties:Resources.OnboardingViewAddTheThreeNewestEligibleTitlesTo}"
							AutomationProperties.HelpText="{Binding FirstFlightActionHelpText}" />
						<components:AttentionBanner Severity="{x:Static components:ComponentSeverity.Info}"
							Title="{x:Static properties:Resources.OnboardingViewYouRemainInControl}"
							Message="{x:Static properties:Resources.OnboardingViewChooseTheFirstFlightActionToAdd}" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="1" Classes="card" CornerRadius="0" BorderThickness="0,1,0,0">
			<Grid Margin="{DynamicResource Libation.Thickness.4}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
				<Button Classes="contemporary" Content="{x:Static properties:Resources.OnboardingViewBack}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
				<Button Grid.Column="2" Classes="contemporary" Content="{Binding SkipText}" Command="{Binding SkipCommand}" />
				<Button Grid.Column="3" Classes="contemporary primary" Content="{Binding NextText}" Command="{Binding NextCommand}" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
