<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:overview="using:LibationAvalonia.Features.Overview"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:designSystem="using:LibationAvalonia.DesignSystem"
	x:Class="LibationAvalonia.Features.Overview.TastingRoomOverviewView"
	x:Name="Root"
	x:DataType="overview:DashboardViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="TastingBookRow" x:DataType="overview:DashboardBookItem">
			<components:BookRow
				Title="{Binding Title}"
				SupportingText="{Binding SupportingText}"
				Metadata="{Binding Metadata}"
				Status="{Binding Status}"
				StatusText="{Binding StatusText}"
				Command="{Binding OpenCommand}"
				CommandParameter="{Binding}" />
		</DataTemplate>
		<DataTemplate x:Key="TastingQueueRow" x:DataType="overview:DashboardQueueItem">
			<components:QueueItem
				Title="{Binding Title}"
				Stage="{Binding Stage}"
				Message="{Binding Message}"
				Status="{Binding Status}"
				StatusText="{Binding StatusText}"
				Progress="{Binding Progress}"
				ShowProgress="{Binding ShowProgress}"
				ErrorDetails="{Binding ErrorDetails}" />
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="overview|TastingRoomOverviewView:standard UniformGrid#TastingMetrics">
			<Setter Property="Columns" Value="2" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact UniformGrid#TastingMetrics">
			<Setter Property="Columns" Value="2" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow UniformGrid#TastingMetrics">
			<Setter Property="Columns" Value="1" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:standard Image#TastingHeroArt">
			<Setter Property="Width" Value="240" />
			<Setter Property="Height" Value="144" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact Image#TastingHeroArt">
			<Setter Property="Width" Value="200" />
			<Setter Property="Height" Value="120" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow Image#TastingHeroArt">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:wide components|DecanterSummary#TastingDecanter">
			<Setter Property="Width" Value="420" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:standard components|DecanterSummary#TastingDecanter">
			<Setter Property="Width" Value="360" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact components|DecanterSummary#TastingDecanter">
			<Setter Property="DockPanel.Dock" Value="Bottom" />
			<Setter Property="Margin" Value="0,16,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow components|DecanterSummary#TastingDecanter">
			<Setter Property="DockPanel.Dock" Value="Bottom" />
			<Setter Property="Margin" Value="0,16,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:wide components|DropZone#TastingDropZone">
			<Setter Property="Width" Value="380" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:standard components|DropZone#TastingDropZone">
			<Setter Property="Width" Value="320" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact components|DropZone#TastingDropZone">
			<Setter Property="DockPanel.Dock" Value="Bottom" />
			<Setter Property="Margin" Value="0,16,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow components|DropZone#TastingDropZone">
			<Setter Property="DockPanel.Dock" Value="Bottom" />
			<Setter Property="Margin" Value="0,16,0,0" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="{DynamicResource Libation.Thickness.5}" Spacing="{DynamicResource Libation.Space.5}">
			<components:PageHeader
				x:Name="TastingHeader"
				Classes="hero"
				Eyebrow="Editorial library workspace"
				Title="Today’s Selection"
				SupportingText="Welcome back. Here is what is happening in your library today.">
				<components:PageHeader.StatusContent>
					<components:StatusBadge
						Status="{Binding AccountStatus}"
						TextOverride="{Binding AccountHealthText}"
						AccessibleName="{Binding AccountHealthText}" />
				</components:PageHeader.StatusContent>
				<components:PageHeader.HeroArt>
					<Image x:Name="TastingHeroArt" Width="320" Height="192" Stretch="Uniform"
						Source="/Assets/ContemporaryCellar/tasting-room-still-life.png" />
				</components:PageHeader.HeroArt>
			</components:PageHeader>

			<Border Classes="card" IsVisible="{Binding IsLoading}"
				AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}">
				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<TextBlock Text="Loading today’s library overview…" FontWeight="SemiBold"
						Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
					<ProgressBar Classes="contemporary prominent" IsIndeterminate="True"
						AutomationProperties.Name="Loading library overview" />
				</StackPanel>
			</Border>

			<components:AttentionBanner
				IsVisible="{Binding HasError}"
				Severity="{x:Static components:ComponentSeverity.Danger}"
				FocusOnShow="True"
				Title="Overview unavailable"
				Message="{Binding ErrorMessage}"
				ActionText="Refresh"
				ActionCommand="{Binding RefreshCommand}"
				SecondaryActionText="Copy technical details"
				SecondaryActionCommand="{Binding CopyTechnicalDetailsCommand}" />

			<StackPanel IsVisible="{Binding HasDashboardData}" Spacing="{DynamicResource Libation.Space.5}">
				<Border Classes="card raised" Padding="0">
					<UniformGrid x:Name="TastingMetrics" Columns="4" Rows="0">
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.library}"
							Value="{Binding TotalTitlesText}" Label="Books in Library"
							CommandText="Open Library" Command="{Binding OpenLibraryCommand}" />
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.downloads}"
							Value="{Binding DownloadPendingText}" Label="Downloads"
							Severity="{x:Static components:ComponentSeverity.Warning}"
							CommandText="Download pending titles" Command="{Binding DownloadPendingCommand}" />
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.processing}"
							Value="{Binding ProcessingText}" Label="Processing"
							Severity="{x:Static components:ComponentSeverity.Info}"
							CommandText="Open Processing" Command="{Binding OpenProcessingCommand}" />
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.completed}"
							Value="{Binding CompletedText}" Label="Completed"
							Severity="{x:Static components:ComponentSeverity.Success}"
							CommandText="Open Library" Command="{Binding OpenLibraryCommand}" />
					</UniformGrid>
				</Border>

				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<components:AttentionBanner
						IsVisible="{Binding IsScanning}"
						Severity="{x:Static components:ComponentSeverity.Info}"
						Title="Scanning your library"
						Message="{Binding ScanStateText}" />
					<components:AttentionBanner
						IsVisible="{Binding IsOffline}"
						Severity="{x:Static components:ComponentSeverity.Warning}"
						Title="Offline"
						Message="Libation cannot confirm account or update status while offline. Your local library remains available."
						ActionText="Refresh"
						ActionCommand="{Binding RefreshCommand}" />
					<components:AttentionBanner
						IsVisible="{Binding IsScanStale}"
						Severity="{x:Static components:ComponentSeverity.Warning}"
						Title="Library scan needs attention"
						Message="The dashboard status source reports that the last successful scan is stale. Scan the library to refresh title availability."
						ActionText="Scan Library"
						ActionCommand="{Binding ScanLibraryCommand}" />
					<components:AttentionBanner
						IsVisible="{Binding HasFailedJobs}"
						Severity="{x:Static components:ComponentSeverity.Danger}"
						Title="Processing needs attention"
						Message="{Binding FailedJobsText}"
						ActionText="Open Processing"
						ActionCommand="{Binding OpenProcessingCommand}" />
				</StackPanel>

				<components:EmptyState
					IsVisible="{Binding ShowNoAccount}"
					IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
					Title="Connect an Audible account"
					Explanation="Add an account to scan the marketplaces where your audiobooks live."
					PrimaryActionText="Add Account"
					PrimaryCommand="{Binding AddAccountCommand}" />
				<components:EmptyState
					IsVisible="{Binding ShowNeedsScan}"
					IllustrationTemplate="{StaticResource illustration.tasting-room.add-books}"
					Title="Your cellar is ready"
					Explanation="Scan your library to bring your titles into Libation."
					PrimaryActionText="Scan Library"
					PrimaryCommand="{Binding ScanLibraryCommand}"
					SecondaryActionText="Manage Accounts"
					SecondaryCommand="{Binding ManageAccountsCommand}" />
				<components:EmptyState
					IsVisible="{Binding ShowScanningEmpty}"
					IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
					Title="Scanning your library"
					Explanation="{Binding ScanStateText}" />
				<components:EmptyState
					IsVisible="{Binding HasCatalogWithoutLocalCopies}"
					IllustrationTemplate="{StaticResource illustration.tasting-room.empty-decanter}"
					Title="Your books are catalogued"
					Explanation="Select titles and choose Process to create open local copies."
					PrimaryActionText="Open Library"
					PrimaryCommand="{Binding OpenLibraryCommand}" />

				<DockPanel x:Name="TastingPrimaryRow" LastChildFill="True">
					<components:DecanterSummary
						x:Name="TastingDecanter"
						Title="The Decanter"
						SummaryText="{Binding QueueSummaryText}"
						ActiveText="{Binding QueueActiveText}"
						Progress="{Binding QueueProgress}"
						ShowProgress="{Binding HasActiveWork}"
						IsExpanded="{Binding IsQueueExpanded, Mode=TwoWay}"
						IllustrationWidth="156"
						IllustrationHeight="188"
						CancelCommand="{Binding CancelAllProcessingCommand}"
						CanCancel="{Binding HasActiveWork}">
						<components:DecanterSummary.IllustrationContent>
							<Image Width="156" Height="188" Stretch="Uniform"
								Source="/Assets/ContemporaryCellar/tasting-room-decanter.png" />
						</components:DecanterSummary.IllustrationContent>
						<components:DecanterSummary.DetailsContent>
							<ListBox ItemsSource="{Binding ActiveQueueItems}" ItemTemplate="{StaticResource TastingQueueRow}"
								MaxHeight="320" AutomationProperties.Name="Active processing work" />
						</components:DecanterSummary.DetailsContent>
					</components:DecanterSummary>
					<components:FlightTray
						Title="Current Flight"
						ItemsSource="{Binding CurrentFlightItems}"
						ItemTemplate="{StaticResource TastingBookRow}"
						CountText="{Binding FlightCountText}"
						DurationText="{Binding FlightDurationText}"
						WarningText="{Binding FlightWarningText}"
						FocusWarningOnShow="{Binding FocusFlightWarning}"
						OutputProfileText="{Binding FlightOutputProfileText}"
						ProcessActionText="{Binding ProcessFlightActionText}"
						ProcessCommand="{Binding ProcessFlightCommand}"
						ClearCommand="{Binding ClearFlightCommand}"
						UndoActionText="{Binding FlightUndoActionText}"
						UndoCommand="{Binding UndoFlightCommand}" />
				</DockPanel>

				<DockPanel x:Name="TastingLowerRow" LastChildFill="True">
					<components:DropZone
						x:Name="TastingDropZone"
						Title="Add books to your cellar"
						Hint="Drag and drop audiobook files or folders, or choose them from this computer."
						AcceptedTypesText="Uses Libation's existing file locator"
						BrowseText="Browse Files"
						BrowseCommand="{Binding LocateAudiobooksCommand}"
						DropCommand="{Binding DropAudiobooksCommand}">
						<components:DropZone.IllustrationContent>
							<Image Width="180" Height="130" Stretch="Uniform"
								Source="/Assets/ContemporaryCellar/tasting-room-book-crate.png" />
						</components:DropZone.IllustrationContent>
					</components:DropZone>
					<Border Classes="card raised" IsVisible="{Binding HasLibrary}">
						<StackPanel Spacing="{DynamicResource Libation.Space.3}">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
								<StackPanel>
									<TextBlock Text="From Your Library" FontFamily="{DynamicResource Libation.Font.Display}"
										FontSize="{DynamicResource Libation.FontSize.Section}" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
									<TextBlock Text="Recently added audiobooks, with their real library status."
										Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
								</StackPanel>
								<Button Grid.Column="1" Classes="contemporary quiet" Content="Open Library"
									Command="{Binding OpenLibraryCommand}" />
							</Grid>
							<Border Classes="card">
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
									<TextBox Text="{Binding SearchText, Mode=TwoWay}"
										PlaceholderText="Search your library" KeyDown="SearchBox_KeyDown"
										AutomationProperties.Name="Search the library" />
									<Button Grid.Column="1" Classes="contemporary" Content="Search"
										Command="{Binding ApplySearchCommand}" />
								</Grid>
							</Border>
							<ListBox ItemsSource="{Binding RecentAdditions}" ItemTemplate="{StaticResource TastingBookRow}"
								MinHeight="180" MaxHeight="380" AutomationProperties.Name="Recent library additions">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
								</ListBox.ItemsPanel>
							</ListBox>
						</StackPanel>
					</Border>
				</DockPanel>

				<Border Classes="card">
					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="{DynamicResource Libation.Space.4}">
						<StackPanel Spacing="{DynamicResource Libation.Space.2}">
							<TextBlock Text="Account health" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
							<components:StatusBadge Status="{Binding AccountStatus}" TextOverride="{Binding AccountHealthText}"
								AccessibleName="{Binding AccountHealthText}" HorizontalAlignment="Left" />
							<Button Classes="contemporary quiet compact" Content="Add or manage account"
								Command="{Binding AddAccountCommand}" HorizontalAlignment="Left" />
						</StackPanel>
						<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.2}">
							<TextBlock Text="Library scan" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
							<components:StatusBadge Status="{Binding ScanStatus}" TextOverride="{Binding ScanStateText}"
								AccessibleName="{Binding ScanStateText}" HorizontalAlignment="Left" />
							<Button Classes="contemporary quiet compact" Content="Scan Library"
								Command="{Binding ScanLibraryCommand}" HorizontalAlignment="Left" />
						</StackPanel>
						<StackPanel Grid.Column="2" Spacing="{DynamicResource Libation.Space.2}">
							<TextBlock Text="Storage and updates" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
							<TextBlock Text="{Binding LocalStorageText, StringFormat='Local storage: {0}'}"
								Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
							<TextBlock Text="{Binding StorageSavedText, StringFormat='Storage saved: {0}'}"
								Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
							<TextBlock Text="{Binding UpdateStateText}" IsVisible="{Binding HasUpdateState}"
								Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap" />
						</StackPanel>
					</Grid>
				</Border>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
