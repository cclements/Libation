<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:overview="using:LibationAvalonia.Features.Overview"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:designSystem="using:LibationAvalonia.DesignSystem"
	xmlns:library="using:LibationAvalonia.Features.Library"
	xmlns:properties="using:LibationAvalonia.Properties"
	x:Class="LibationAvalonia.Features.Overview.TastingRoomOverviewView"
	x:Name="Root"
	x:DataType="overview:DashboardViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="TastingFlightRow" x:DataType="overview:DashboardBookItem">
			<Border BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}" BorderThickness="0,0,0,1"
				Padding="0,8">
				<Grid ColumnDefinitions="48,*,160" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<library:CachedCover Width="44" Height="44" Book="{Binding LibraryBook}"
						Cache="{Binding Library.CoverCache, ElementName=Root}"
						Variant="Small" DecodePixelWidth="88" AccessibleName="{Binding Title}" />
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="{Binding Title}" FontWeight="SemiBold"
							Foreground="{DynamicResource Libation.Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
						<TextBlock Text="{Binding SupportingText}" FontSize="{DynamicResource Libation.FontSize.BodySmall}"
							Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel Grid.Column="2" Spacing="{DynamicResource Libation.Space.1}" VerticalAlignment="Center">
						<TextBlock Text="{Binding ProcessingStatusText}" FontWeight="SemiBold"
							Foreground="{DynamicResource Libation.Brush.AccentPrimary}"
							TextTrimming="CharacterEllipsis"
							IsVisible="{Binding ProcessingStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
						<TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Libation.FontSize.Caption}"
							Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap"
							IsVisible="{Binding ProcessingStatusText, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
						<ProgressBar Classes="contemporary" Minimum="0" Maximum="100"
							Value="{Binding ProcessingProgress}" IsVisible="{Binding ShowProcessingProgress}"
							AutomationProperties.Name="{x:Static properties:Resources.TastingRoomOverviewViewTitleProcessingProgress}" />
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="TastingRecentWideRow" x:DataType="overview:DashboardBookItem">
			<Button Classes="contemporary quiet" Command="{Binding OpenCommand}" CommandParameter="{Binding}"
				HorizontalContentAlignment="Stretch" Padding="4">
				<Grid ColumnDefinitions="44,2*,*,*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
					<library:CachedCover Width="36" Height="36" Book="{Binding LibraryBook}"
						Cache="{Binding Library.CoverCache, ElementName=Root}"
						Variant="Small" DecodePixelWidth="72" AccessibleName="{Binding Title}" />
					<TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
						VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Column="2" Text="{Binding Author}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Column="3" Text="{Binding Narrator}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
					<TextBlock Grid.Column="4" Text="{Binding DurationText}" VerticalAlignment="Center" />
					<TextBlock Grid.Column="5" Text="{Binding AddedText}" VerticalAlignment="Center" />
				</Grid>
			</Button>
		</DataTemplate>

		<DataTemplate x:Key="TastingRecentCompactRow" x:DataType="overview:DashboardBookItem">
			<Button Classes="contemporary quiet" Command="{Binding OpenCommand}" CommandParameter="{Binding}"
				HorizontalContentAlignment="Stretch" Padding="4">
				<Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
					<library:CachedCover Width="36" Height="36" Book="{Binding LibraryBook}"
						Cache="{Binding Library.CoverCache, ElementName=Root}"
						Variant="Small" DecodePixelWidth="72" AccessibleName="{Binding Title}" />
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
						<TextBlock Text="{Binding SupportingText}" FontSize="{DynamicResource Libation.FontSize.Caption}"
							Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="{Binding DurationText}" HorizontalAlignment="Right" />
						<TextBlock Text="{Binding AddedText}" HorizontalAlignment="Right"
							FontSize="{DynamicResource Libation.FontSize.Caption}"
							Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					</StackPanel>
				</Grid>
			</Button>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="overview|TastingRoomOverviewView UniformGrid#TastingMetrics">
			<Setter Property="Columns" Value="4" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView ItemsControl#RecentCompactList">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:wide ContentControl#DecanterSurfaceHost">
			<Setter Property="Width" Value="380" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:standard ContentControl#DecanterSurfaceHost">
			<Setter Property="Width" Value="340" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact ContentControl#DecanterSurfaceHost">
			<Setter Property="DockPanel.Dock" Value="Top" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow ContentControl#DecanterSurfaceHost">
			<Setter Property="DockPanel.Dock" Value="Top" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:wide components|DropZone#TastingDropZone">
			<Setter Property="Width" Value="320" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:standard components|DropZone#TastingDropZone">
			<Setter Property="Width" Value="280" />
			<Setter Property="DockPanel.Dock" Value="Right" />
			<Setter Property="Margin" Value="16,0,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact components|DropZone#TastingDropZone">
			<Setter Property="DockPanel.Dock" Value="Bottom" />
			<Setter Property="Margin" Value="0,12,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow components|DropZone#TastingDropZone">
			<Setter Property="DockPanel.Dock" Value="Bottom" />
			<Setter Property="Margin" Value="0,12,0,0" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact Border#RecentWideTable">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow Border#RecentWideTable">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:compact ItemsControl#RecentCompactList">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow ItemsControl#RecentCompactList">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector="overview|TastingRoomOverviewView:narrow UniformGrid#TastingMetrics">
			<Setter Property="Columns" Value="2" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="{DynamicResource Libation.Thickness.4}" Spacing="{DynamicResource Libation.Space.3}">
			<Border Classes="card" IsVisible="{Binding IsLoading}"
				AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}">
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBlock Text="{x:Static properties:Resources.TastingRoomOverviewViewLoadingTodaySSelection}" FontWeight="SemiBold" />
					<ProgressBar Classes="contemporary prominent" IsIndeterminate="True"
						AutomationProperties.Name="{x:Static properties:Resources.TastingRoomOverviewViewLoadingTodaySSelection2}" />
				</StackPanel>
			</Border>

			<components:AttentionBanner IsVisible="{Binding HasError}"
				Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
				Title="{x:Static properties:Resources.CellarOverviewViewOverviewUnavailable}" Message="{Binding ErrorMessage}"
				ActionText="{x:Static properties:Resources.DownloadsViewRefresh}" ActionCommand="{Binding RefreshCommand}"
				SecondaryActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}" SecondaryActionCommand="{Binding CopyTechnicalDetailsCommand}" />
			<components:AttentionBanner IsVisible="{Binding IsOffline}"
				Severity="{x:Static components:ComponentSeverity.Warning}" Title="{x:Static properties:Resources.CellarOverviewViewOffline}"
				Message="{x:Static properties:Resources.CellarOverviewViewYourLocalLibraryRemainsAvailableButAccount}"
				ActionText="{x:Static properties:Resources.DownloadsViewRefresh}" ActionCommand="{Binding RefreshCommand}" />
			<components:AttentionBanner IsVisible="{Binding IsScanStale}"
				Severity="{x:Static components:ComponentSeverity.Warning}" Title="{x:Static properties:Resources.CellarOverviewViewLibraryScanNeedsAttention}"
				Message="{x:Static properties:Resources.CellarOverviewViewTheLastSuccessfulScanIsStaleScan}"
				ActionText="{x:Static properties:Resources.CellarOverviewViewScanLibrary}" ActionCommand="{Binding ScanLibraryCommand}" />
			<components:AttentionBanner IsVisible="{Binding HasFailedJobs}"
				Severity="{x:Static components:ComponentSeverity.Danger}" Title="{x:Static properties:Resources.CellarOverviewViewProcessingNeedsAttention}"
				Message="{Binding FailedJobsText}" ActionText="{x:Static properties:Resources.TastingRoomOverviewViewViewProcessing}" ActionCommand="{Binding OpenProcessingCommand}" />

			<StackPanel IsVisible="{Binding HasDashboardData}" Spacing="{DynamicResource Libation.Space.3}">
				<Border Classes="card raised" Padding="0">
					<UniformGrid x:Name="TastingMetrics" Rows="0">
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.library}"
							Value="{Binding TotalTitlesText}" Label="{x:Static properties:Resources.TastingRoomOverviewViewBooksInLibrary}" DeltaText="{Binding AddedThisWeekDeltaText}"
							CommandText="{x:Static properties:Resources.CellarOverviewViewOpenLibrary}" Command="{Binding OpenLibraryCommand}" />
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.downloads}"
							Value="{Binding DownloadPendingText}" Label="{x:Static properties:Resources.RouteDownloadsLabel}" DeltaText="{Binding DownloadsDeltaText}"
							Severity="{x:Static components:ComponentSeverity.Warning}"
							CommandText="{x:Static properties:Resources.CellarOverviewViewDownloadPendingTitles}" Command="{Binding DownloadPendingCommand}" />
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.processing}"
							Value="{Binding ProcessingText}" Label="{x:Static properties:Resources.RouteProcessingLabel}" DeltaText="{Binding ProcessingDeltaText}"
							Severity="{x:Static components:ComponentSeverity.Info}"
							CommandText="{x:Static properties:Resources.CellarOverviewViewOpenProcessing}" Command="{Binding OpenProcessingCommand}" />
						<components:MetricCard Classes="strip" IconData="{StaticResource glyph.completed}"
							Value="{Binding CompletedText}" Label="{x:Static properties:Resources.CellarOverviewViewCompleted}" DeltaText="{Binding CompletedDeltaText}"
							Severity="{x:Static components:ComponentSeverity.Success}"
							CommandText="{x:Static properties:Resources.CellarOverviewViewOpenLibrary}" Command="{Binding OpenLibraryCommand}" />
					</UniformGrid>
				</Border>

				<components:EmptyState IsVisible="{Binding ShowNoAccount}"
					IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
					Title="{x:Static properties:Resources.CellarOverviewViewConnectAnAudibleAccount}"
					Explanation="{x:Static properties:Resources.CellarOverviewViewAddAnAccountToScanTheMarketplaces}"
					PrimaryActionText="{x:Static properties:Resources.CellarOverviewViewAddAccount}" PrimaryCommand="{Binding AddAccountCommand}" />
				<components:EmptyState IsVisible="{Binding ShowNeedsScan}"
					IllustrationTemplate="{StaticResource illustration.tasting-room.add-books}"
					Title="{x:Static properties:Resources.CellarOverviewViewYourCellarIsReady}"
					Explanation="{x:Static properties:Resources.CellarOverviewViewScanYourLibraryToBringYourTitles}"
					PrimaryActionText="{x:Static properties:Resources.CellarOverviewViewScanLibrary}" PrimaryCommand="{Binding ScanLibraryCommand}"
					SecondaryActionText="{x:Static properties:Resources.CellarOverviewViewManageAccounts}" SecondaryCommand="{Binding ManageAccountsCommand}" />
				<components:EmptyState IsVisible="{Binding ShowScanningEmpty}"
					IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
					Title="{x:Static properties:Resources.CellarOverviewViewScanningYourLibrary}" Explanation="{Binding ScanStateText}" />

				<DockPanel x:Name="TastingPrimaryRow" LastChildFill="True" IsVisible="{Binding HasLibrary}">
					<ContentControl x:Name="DecanterSurfaceHost" />
					<Border Classes="card raised">
						<Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Libation.Space.2}">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
								<StackPanel>
									<TextBlock Text="{x:Static properties:Resources.TastingRoomOverviewViewCurrentFlight}" FontFamily="{DynamicResource Libation.Font.Display}"
										FontSize="{DynamicResource Libation.FontSize.Section}" />
									<TextBlock Text="{Binding FlightCountText, StringFormat={x:Static properties:Resources.TastingRoomCuratedBatchFormat}}"
										Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
								</StackPanel>
								<Button Grid.Column="1" Classes="contemporary quiet compact" Content="{x:Static properties:Resources.TastingRoomOverviewViewViewProcessing}"
									Command="{Binding OpenProcessingCommand}" />
							</Grid>
							<Grid Grid.Row="1">
								<TextBlock IsVisible="{Binding HasNoFlight}" Text="{x:Static properties:Resources.TastingRoomOverviewViewSelectTitlesInTheLibraryToBuild}"
									Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,12" />
								<ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
									<ItemsControl IsVisible="{Binding HasFlight}" ItemsSource="{Binding CurrentFlightItems}"
										ItemTemplate="{StaticResource TastingFlightRow}" />
								</ScrollViewer>
							</Grid>
						</Grid>
					</Border>
				</DockPanel>

				<DockPanel x:Name="TastingLowerRow" LastChildFill="True" IsVisible="{Binding HasLibrary}">
					<components:DropZone x:Name="TastingDropZone"
						Title="{x:Static properties:Resources.TastingRoomOverviewViewAddBooksToYourCellar}"
						Hint="{x:Static properties:Resources.TastingRoomOverviewViewDragAndDropAudiobookFilesOrFolders}"
						AcceptedTypesText="{x:Static properties:Resources.SupportedAudiobookFileTypes}"
						BrowseText="{x:Static properties:Resources.TastingRoomOverviewViewBrowseFiles}" BrowseCommand="{Binding LocateAudiobooksCommand}"
						DropCommand="{Binding DropAudiobooksCommand}">
						<components:DropZone.IllustrationContent>
							<Image Width="160" Height="112" Stretch="Uniform"
								Source="/Assets/ContemporaryCellar/tasting-room-book-crate.png" />
						</components:DropZone.IllustrationContent>
					</components:DropZone>

					<Border Classes="card raised">
						<Grid RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource Libation.Space.2}">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
								<StackPanel>
									<TextBlock Text="{x:Static properties:Resources.TastingRoomOverviewViewFromYourCellar}" FontFamily="{DynamicResource Libation.Font.Display}"
										FontSize="{DynamicResource Libation.FontSize.Section}" />
									<TextBlock Text="{x:Static properties:Resources.TastingRoomOverviewViewYourTenMostRecentAudiobooks}"
										Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
								</StackPanel>
								<Button Grid.Column="1" Classes="contemporary quiet compact" Content="{x:Static properties:Resources.CellarOverviewViewOpenLibrary}"
									Command="{Binding OpenLibraryCommand}" />
							</Grid>
							<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
								<ComboBox Width="170" ItemsSource="{Binding LibraryScopes}"
									SelectedItem="{Binding SelectedLibraryScope, Mode=TwoWay}"
									AutomationProperties.Name="{x:Static properties:Resources.TastingRoomOverviewViewRecentLibraryScope}" />
								<TextBox Grid.Column="1" Classes="contemporary search" Text="{Binding SearchText, Mode=TwoWay}"
									PlaceholderText="{x:Static properties:Resources.TastingRoomOverviewViewSearchLibrary}" KeyDown="SearchBox_KeyDown"
									AutomationProperties.Name="{x:Static properties:Resources.TastingRoomOverviewViewSearchAndOpenTheLibrary}" />
								<Button Grid.Column="2" Classes="contemporary" Content="{x:Static properties:Resources.TastingRoomOverviewViewSearch}"
									Command="{Binding OpenFilteredLibraryCommand}" />
							</Grid>
							<Grid Grid.Row="2">
								<Border x:Name="RecentWideTable" BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}" BorderThickness="1"
									CornerRadius="{DynamicResource Libation.Radius.Small}" Padding="{DynamicResource Libation.Thickness.2}">
									<Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Libation.Space.1}">
										<Grid ColumnDefinitions="44,2*,*,*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
											<TextBlock Grid.Column="1" Text="{x:Static properties:Resources.TastingRoomOverviewViewTitle}" FontWeight="SemiBold" />
											<TextBlock Grid.Column="2" Text="{x:Static properties:Resources.TastingRoomOverviewViewAuthor}" FontWeight="SemiBold" />
											<TextBlock Grid.Column="3" Text="{x:Static properties:Resources.TastingRoomOverviewViewNarrator}" FontWeight="SemiBold" />
											<TextBlock Grid.Column="4" Text="{x:Static properties:Resources.TastingRoomOverviewViewLength}" FontWeight="SemiBold" />
											<TextBlock Grid.Column="5" Text="{x:Static properties:Resources.TastingRoomOverviewViewAdded}" FontWeight="SemiBold" />
										</Grid>
										<ScrollViewer Grid.Row="1" MaxHeight="350" VerticalScrollBarVisibility="Auto">
											<ItemsControl ItemsSource="{Binding TastingLibraryItems}"
												ItemTemplate="{StaticResource TastingRecentWideRow}" />
										</ScrollViewer>
									</Grid>
								</Border>
								<ItemsControl x:Name="RecentCompactList"
									ItemsSource="{Binding TastingLibraryItems}"
									ItemTemplate="{StaticResource TastingRecentCompactRow}" />
							</Grid>
						</Grid>
					</Border>
				</DockPanel>

				<Border Classes="card" IsVisible="{Binding ShowAccountScanStrip}" Padding="{DynamicResource Libation.Thickness.3}">
					<WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
						<components:StatusBadge Margin="0,0,12,0" Status="{Binding AccountStatus}"
							TextOverride="{Binding AccountHealthText}" AccessibleName="{Binding AccountHealthText}" />
						<components:StatusBadge Margin="0,0,12,0" Status="{Binding ScanStatus}"
							TextOverride="{Binding ScanStateText}" AccessibleName="{Binding ScanStateText}" />
						<Button Classes="contemporary quiet compact" Content="{x:Static properties:Resources.CellarOverviewViewScanLibrary}" Command="{Binding ScanLibraryCommand}" />
					</WrapPanel>
				</Border>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
