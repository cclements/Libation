<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="using:LibationAvalonia.Properties"
	xmlns:overview="using:LibationAvalonia.Features.Overview"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:designSystem="using:LibationAvalonia.DesignSystem"
	xmlns:library="using:LibationAvalonia.Features.Library"
	x:Class="LibationAvalonia.Features.Overview.CellarOverviewView"
	x:Name="Root"
	x:DataType="overview:DashboardViewModel">
	<UserControl.Styles>
		<Style Selector="overview|CellarOverviewView UniformGrid#CellarMetrics">
			<Setter Property="Columns" Value="5" />
		</Style>
		<Style Selector="overview|CellarOverviewView ScrollViewer#CellarScroll">
			<Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
		</Style>
		<Style Selector="overview|CellarOverviewView:compact ComboBox#CellarViewChoice">
			<Setter Property="Width" Value="120" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow ComboBox#CellarViewChoice">
			<Setter Property="Width" Value="110" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow UniformGrid#CellarMetrics">
			<Setter Property="Columns" Value="2" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow ScrollViewer#CellarScroll">
			<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer x:Name="CellarScroll" HorizontalScrollBarVisibility="Disabled">
	<Grid Margin="{DynamicResource Libation.Thickness.4}"
		RowDefinitions="Auto,Auto,*"
		RowSpacing="{DynamicResource Libation.Space.3}">
		<StackPanel Spacing="{DynamicResource Libation.Space.2}">
			<Border Classes="card" IsVisible="{Binding IsLoading}"
				AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}">
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBlock Text="{x:Static properties:Resources.CellarOverviewViewLoadingYourLibraryOverview}" FontWeight="SemiBold"
						Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
					<ProgressBar Classes="contemporary prominent" IsIndeterminate="True"
						AutomationProperties.Name="{x:Static properties:Resources.CellarOverviewViewLoadingLibraryOverview}" />
				</StackPanel>
			</Border>

			<components:AttentionBanner
				IsVisible="{Binding HasError}"
				Severity="{x:Static components:ComponentSeverity.Danger}"
				FocusOnShow="True"
				Title="{x:Static properties:Resources.CellarOverviewViewOverviewUnavailable}"
				Message="{Binding ErrorMessage}"
				ActionText="{x:Static properties:Resources.DownloadsViewRefresh}"
				ActionCommand="{Binding RefreshCommand}"
				SecondaryActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}"
				SecondaryActionCommand="{Binding CopyTechnicalDetailsCommand}" />
			<components:AttentionBanner IsVisible="{Binding IsOffline}"
				Severity="{x:Static components:ComponentSeverity.Warning}"
				Title="{x:Static properties:Resources.CellarOverviewViewOffline}"
				Message="{x:Static properties:Resources.CellarOverviewViewYourLocalLibraryRemainsAvailableButAccount}"
				ActionText="{x:Static properties:Resources.DownloadsViewRefresh}" ActionCommand="{Binding RefreshCommand}" />
			<components:AttentionBanner IsVisible="{Binding IsScanStale}"
				Severity="{x:Static components:ComponentSeverity.Warning}"
				Title="{x:Static properties:Resources.CellarOverviewViewLibraryScanNeedsAttention}"
				Message="{x:Static properties:Resources.CellarOverviewViewTheLastSuccessfulScanIsStaleScan}"
				ActionText="{x:Static properties:Resources.CellarOverviewViewScanLibrary}" ActionCommand="{Binding ScanLibraryCommand}" />
			<components:AttentionBanner IsVisible="{Binding HasFailedJobs}"
				Severity="{x:Static components:ComponentSeverity.Danger}"
				Title="{x:Static properties:Resources.CellarOverviewViewProcessingNeedsAttention}"
				Message="{Binding FailedJobsText}"
				ActionText="{x:Static properties:Resources.CellarOverviewViewOpenProcessing}" ActionCommand="{Binding OpenProcessingCommand}" />
		</StackPanel>

		<Grid Grid.Row="1" IsVisible="{Binding HasLibrary}"
			RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Libation.Space.3}">
			<Border Classes="card" Padding="{DynamicResource Libation.Thickness.3}">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
					<TextBox Classes="contemporary search"
						Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						PlaceholderText="{x:Static properties:Resources.CellarOverviewViewSearchTitlesAuthorsNarratorsOrTags}"
						KeyDown="SearchBox_KeyDown"
						AutomationProperties.Name="{x:Static properties:Resources.CellarOverviewViewSearchTheCellarLibrary}" />
					<Button Grid.Column="1" Classes="contemporary quiet compact" Content="{x:Static properties:Resources.CellarOverviewViewFilter}"
						Command="{Binding Library.OpenFilterHelpCommand, ElementName=Root}"
						AutomationProperties.Name="{x:Static properties:Resources.CellarOverviewViewOpenLibraryFilterHelp}" />
					<ComboBox x:Name="CellarViewChoice" Grid.Column="2" Width="148"
						ItemsSource="{Binding ViewModes, ElementName=Root}"
						SelectedItem="{Binding Library.ViewMode, ElementName=Root, Mode=TwoWay}"
						AutomationProperties.Name="{x:Static properties:Resources.CellarOverviewViewPreferredLibraryView}" />
				</Grid>
			</Border>

			<UniformGrid x:Name="CellarMetrics" Grid.Row="1" Rows="0">
				<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.library}"
					Value="{Binding TotalTitlesText}" Label="{x:Static properties:Resources.AccountsViewTitles}"
					CommandText="{x:Static properties:Resources.CellarOverviewViewOpenLibrary}" Command="{Binding OpenLibraryCommand}" />
				<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.completed}"
					Value="{Binding CompletedText}" Label="{x:Static properties:Resources.CellarOverviewViewCompleted}"
					Severity="{x:Static components:ComponentSeverity.Success}"
					CommandText="{x:Static properties:Resources.CellarOverviewViewOpenLibrary}" Command="{Binding OpenLibraryCommand}" />
				<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.downloads}"
					Value="{Binding DownloadPendingText}" Label="{x:Static properties:Resources.CellarOverviewViewDownloadPending}"
					Severity="{x:Static components:ComponentSeverity.Warning}"
					CommandText="{x:Static properties:Resources.CellarOverviewViewDownloadPendingTitles}" Command="{Binding DownloadPendingCommand}" />
				<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.processing}"
					Value="{Binding ProcessingText}" Label="{x:Static properties:Resources.CellarOverviewViewInProgress}"
					Severity="{x:Static components:ComponentSeverity.Info}"
					CommandText="{x:Static properties:Resources.CellarOverviewViewOpenProcessing}" Command="{Binding OpenProcessingCommand}" />
				<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.metadata}"
					Value="{Binding TotalSizeText}" Label="{x:Static properties:Resources.CellarOverviewViewTotalSize}"
					StatusText="{Binding StorageStatusText}" />
			</UniformGrid>
		</Grid>

		<Grid Grid.Row="2" IsVisible="{Binding HasDashboardData}">
			<components:EmptyState IsVisible="{Binding ShowNoAccount}"
				IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
				Title="{x:Static properties:Resources.CellarOverviewViewConnectAnAudibleAccount}"
				Explanation="{x:Static properties:Resources.CellarOverviewViewAddAnAccountToScanTheMarketplaces}"
				PrimaryActionText="{x:Static properties:Resources.CellarOverviewViewAddAccount}" PrimaryCommand="{Binding AddAccountCommand}" />
			<components:EmptyState IsVisible="{Binding ShowNeedsScan}"
				IllustrationTemplate="{StaticResource illustration.cellar.empty-library}"
				Title="{x:Static properties:Resources.CellarOverviewViewYourCellarIsReady}"
				Explanation="{x:Static properties:Resources.CellarOverviewViewScanYourLibraryToBringYourTitles}"
				PrimaryActionText="{x:Static properties:Resources.CellarOverviewViewScanLibrary}" PrimaryCommand="{Binding ScanLibraryCommand}"
				SecondaryActionText="{x:Static properties:Resources.CellarOverviewViewManageAccounts}" SecondaryCommand="{Binding ManageAccountsCommand}" />
			<components:EmptyState IsVisible="{Binding ShowScanningEmpty}"
				IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
				Title="{x:Static properties:Resources.CellarOverviewViewScanningYourLibrary}" Explanation="{Binding ScanStateText}" />

			<Grid x:Name="CellarWorkArea" IsVisible="{Binding HasLibrary}"
				ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
				<Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Libation.Space.2}">
					<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
						<StackPanel>
							<TextBlock Text="{x:Static properties:Resources.CellarOverviewViewYourLibrary}" FontFamily="{DynamicResource Libation.Font.Display}"
								FontSize="{DynamicResource Libation.FontSize.Section}"
								Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
							<TextBlock Text="{Binding VisibleLibrarySummary}"
								Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						</StackPanel>
						<ComboBox Grid.Column="1" Width="180"
							ItemsSource="{Binding Library.SortOptions, ElementName=Root}"
							SelectedItem="{Binding Library.SelectedSort, ElementName=Root, Mode=TwoWay}"
							AutomationProperties.Name="{x:Static properties:Resources.CellarOverviewViewSortTheCellarGallery}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="library:LibrarySortOption">
									<TextBlock Text="{Binding Label}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Button Grid.Column="2" Classes="contemporary quiet compact" Content="{x:Static properties:Resources.CellarOverviewViewSelectVisible}"
							Command="{Binding Library.SelectAllVisibleCommand, ElementName=Root}" />
					</Grid>
					<Border Grid.Row="1" Classes="card"
						Background="{DynamicResource Libation.Brush.SurfaceSunken}"
						BorderBrush="{DynamicResource Libation.Brush.BorderStrong}"
						Padding="{DynamicResource Libation.Thickness.3}" ClipToBounds="True">
						<library:LibraryGalleryView DataContext="{Binding Library, ElementName=Root}" />
					</Border>
				</Grid>

				<ContentControl x:Name="FlightSurfaceHost" Grid.Column="1" Width="360" />
			</Grid>
		</Grid>
	</Grid>
	</ScrollViewer>
</UserControl>
