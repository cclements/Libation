<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:overview="using:LibationAvalonia.Features.Overview"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:designSystem="using:LibationAvalonia.DesignSystem"
	xmlns:flight="using:LibationAvalonia.Features.Flight"
	xmlns:library="using:LibationAvalonia.Features.Library"
	x:Class="LibationAvalonia.Features.Overview.CellarOverviewView"
	x:Name="Root"
	x:DataType="overview:DashboardViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="CellarLibraryRow" x:DataType="overview:DashboardBookItem">
			<components:BookRow
				Title="{Binding Title}"
				SupportingText="{Binding SupportingText}"
				Metadata="{Binding Metadata}"
				Status="{Binding Status}"
				StatusText="{Binding StatusText}"
				Command="{Binding OpenCommand}"
				CommandParameter="{Binding}" />
		</DataTemplate>
		<DataTemplate x:Key="CellarQueueRow" x:DataType="overview:DashboardQueueItem">
			<components:QueueItem
				Title="{Binding Title}"
				Stage="{Binding Stage}"
				Message="{Binding Message}"
				Status="{Binding Status}"
				StatusText="{Binding StatusText}"
				Progress="{Binding Progress}"
				ShowProgress="{Binding ShowProgress}"
				ErrorDetails="{Binding ErrorDetails}" />
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="overview|CellarOverviewView:standard UniformGrid#CellarMetrics">
			<Setter Property="Columns" Value="3" />
		</Style>
		<Style Selector="overview|CellarOverviewView:compact UniformGrid#CellarMetrics">
			<Setter Property="Columns" Value="2" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow UniformGrid#CellarMetrics">
			<Setter Property="Columns" Value="1" />
		</Style>
		<Style Selector="overview|CellarOverviewView:standard flight|CurrentFlightView#WideFlight">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|CellarOverviewView:compact flight|CurrentFlightView#WideFlight">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow flight|CurrentFlightView#WideFlight">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="overview|CellarOverviewView:standard Expander#CompactFlight">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector="overview|CellarOverviewView:compact Expander#CompactFlight">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow Expander#CompactFlight">
			<Setter Property="IsVisible" Value="True" />
		</Style>
		<Style Selector="overview|CellarOverviewView:narrow ContentControl#CellarHeroArt">
			<Setter Property="IsVisible" Value="False" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="{DynamicResource Libation.Thickness.4}" Spacing="{DynamicResource Libation.Space.4}">
			<components:PageHeader
				Eyebrow="Library workspace"
				Title="The Cellar"
				SupportingText="Your curated audiobook collection, organized and ready for the next listen."
				PrimaryActionText="Locate Audiobooks"
				PrimaryCommand="{Binding LocateAudiobooksCommand}">
				<components:PageHeader.StatusContent>
					<components:StatusBadge
						Status="{Binding AccountStatus}"
						TextOverride="{Binding AccountHealthText}"
						AccessibleName="{Binding AccountHealthText}" />
				</components:PageHeader.StatusContent>
			</components:PageHeader>

			<Border Classes="card" IsVisible="{Binding IsLoading}"
				AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}">
				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<TextBlock Text="Loading your library overview…" FontWeight="SemiBold"
						Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
					<ProgressBar Classes="contemporary prominent" IsIndeterminate="True"
						AutomationProperties.Name="Loading library overview" />
				</StackPanel>
			</Border>

			<components:AttentionBanner
				IsVisible="{Binding HasError}"
				Severity="{x:Static components:ComponentSeverity.Danger}"
				FocusOnShow="True"
				Title="Overview unavailable"
				Message="{Binding ErrorMessage}"
				ActionText="Refresh"
				ActionCommand="{Binding RefreshCommand}"
				SecondaryActionText="Copy technical details"
				SecondaryActionCommand="{Binding CopyTechnicalDetailsCommand}" />

			<StackPanel IsVisible="{Binding HasDashboardData}" Spacing="{DynamicResource Libation.Space.4}">
				<Border Classes="card">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
						<TextBox
							Text="{Binding SearchText, Mode=TwoWay}"
							PlaceholderText="Search titles, authors, narrators, or tags"
							KeyDown="SearchBox_KeyDown"
							AutomationProperties.Name="Search the Cellar library" />
						<Button Grid.Column="1" Classes="contemporary" Content="Search"
							Command="{Binding ApplySearchCommand}" />
					</Grid>
				</Border>

				<UniformGrid x:Name="CellarMetrics" Columns="5" Rows="0">
					<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.library}"
						Value="{Binding TotalTitlesText}" Label="Titles in Library"
						CommandText="Open Library" Command="{Binding OpenLibraryCommand}" />
					<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.completed}"
						Value="{Binding CompletedText}" Label="Completed"
						Severity="{x:Static components:ComponentSeverity.Success}"
						CommandText="Open Library" Command="{Binding OpenLibraryCommand}" />
					<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.downloads}"
						Value="{Binding DownloadPendingText}" Label="Download Pending"
						Severity="{x:Static components:ComponentSeverity.Warning}"
						CommandText="Download pending titles" Command="{Binding DownloadPendingCommand}" />
					<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.processing}"
						Value="{Binding ProcessingText}" Label="Processing Work"
						Severity="{x:Static components:ComponentSeverity.Info}"
						CommandText="Open Processing" Command="{Binding OpenProcessingCommand}" />
					<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.metadata}"
						Value="{Binding LocalStorageText}" Label="Local Storage"
						StatusText="{Binding StorageStatusText}" />
				</UniformGrid>

				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<components:AttentionBanner
						IsVisible="{Binding IsScanning}"
						Severity="{x:Static components:ComponentSeverity.Info}"
						Title="Scanning your library"
						Message="{Binding ScanStateText}" />
					<components:AttentionBanner
						IsVisible="{Binding IsOffline}"
						Severity="{x:Static components:ComponentSeverity.Warning}"
						Title="Offline"
						Message="Libation cannot confirm account or update status while offline. Your local library remains available."
						ActionText="Refresh"
						ActionCommand="{Binding RefreshCommand}" />
					<components:AttentionBanner
						IsVisible="{Binding IsScanStale}"
						Severity="{x:Static components:ComponentSeverity.Warning}"
						Title="Library scan needs attention"
						Message="The dashboard status source reports that the last successful scan is stale. Scan the library to refresh title availability."
						ActionText="Scan Library"
						ActionCommand="{Binding ScanLibraryCommand}" />
					<components:AttentionBanner
						IsVisible="{Binding HasFailedJobs}"
						Severity="{x:Static components:ComponentSeverity.Danger}"
						Title="Processing needs attention"
						Message="{Binding FailedJobsText}"
						ActionText="Open Processing"
						ActionCommand="{Binding OpenProcessingCommand}" />
				</StackPanel>

				<components:EmptyState
					IsVisible="{Binding ShowNoAccount}"
					IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
					Title="Connect an Audible account"
					Explanation="Add an account to scan the marketplaces where your audiobooks live."
					PrimaryActionText="Add Account"
					PrimaryCommand="{Binding AddAccountCommand}" />
				<components:EmptyState
					IsVisible="{Binding ShowNeedsScan}"
					IllustrationTemplate="{StaticResource illustration.cellar.empty-library}"
					Title="Your cellar is ready"
					Explanation="Scan your library to bring your titles into Libation."
					PrimaryActionText="Scan Library"
					PrimaryCommand="{Binding ScanLibraryCommand}"
					SecondaryActionText="Manage Accounts"
					SecondaryCommand="{Binding ManageAccountsCommand}" />
				<components:EmptyState
					IsVisible="{Binding ShowScanningEmpty}"
					IllustrationTemplate="{StaticResource illustration.shared.account-connection}"
					Title="Scanning your library"
					Explanation="{Binding ScanStateText}" />
				<components:EmptyState
					IsVisible="{Binding HasCatalogWithoutLocalCopies}"
					IllustrationTemplate="{StaticResource illustration.cellar.empty-decanter}"
					Title="Your books are catalogued"
					Explanation="Select titles and choose Process to create open local copies."
					PrimaryActionText="Open Library"
					PrimaryCommand="{Binding OpenLibraryCommand}" />

				<Grid x:Name="CellarWorkArea" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.4}">
					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
							<StackPanel>
								<TextBlock Text="Your Library" FontFamily="{DynamicResource Libation.Font.Display}"
									FontSize="{DynamicResource Libation.FontSize.Section}" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
								<TextBlock Text="{Binding VisibleLibrarySummary}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
							</StackPanel>
							<Button Grid.Column="1" Classes="contemporary quiet" Content="Open full Library"
								Command="{Binding OpenLibraryCommand}" />
						</Grid>
						<Border Classes="card" Background="{DynamicResource Libation.Brush.SurfaceSunken}"
							BorderBrush="{DynamicResource Libation.Brush.BorderStrong}"
							Padding="{DynamicResource Libation.Thickness.3}" ClipToBounds="True">
							<library:LibraryGalleryView
								Height="448"
								DataContext="{Binding Library, ElementName=Root}" />
						</Border>
						<Expander x:Name="CompactFlight" IsVisible="False" IsExpanded="{Binding IsFlightExpanded, Mode=TwoWay}">
							<Expander.Header>
								<Button Classes="contemporary quiet" Content="{Binding FlightCountText, StringFormat='Current Flight — {0}'}"
									Command="{Binding ToggleFlightExpandedCommand}" />
							</Expander.Header>
							<flight:CurrentFlightView DataContext="{Binding CurrentFlight, Mode=OneTime}" />
						</Expander>
						<components:DropZone
							Title="Locate audiobooks"
							Hint="Choose audiobook files or folders already on this computer."
							AcceptedTypesText="Uses Libation's existing file locator"
							BrowseCommand="{Binding LocateAudiobooksCommand}"
							DropCommand="{Binding DropAudiobooksCommand}" />
					</StackPanel>

					<flight:CurrentFlightView
						x:Name="WideFlight"
						Grid.Column="1"
						Width="360"
						DataContext="{Binding CurrentFlight, Mode=OneTime}" />
				</Grid>

			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
