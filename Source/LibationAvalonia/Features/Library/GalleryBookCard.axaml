<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="using:LibationAvalonia.Properties"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 xmlns:library="using:LibationAvalonia.Features.Library"
			 x:Class="LibationAvalonia.Features.Library.GalleryBookCard"
			 x:DataType="library:LibraryBookItemViewModel"
			 x:Name="Root"
			 Focusable="True"
			 AutomationProperties.Name="{Binding AccessibleName}"
			 AutomationProperties.HelpText="{x:Static properties:Resources.GalleryBookCardUseArrowKeysToMoveSpaceTo}">
	<Grid RowDefinitions="*,Auto">
		<components:BookCard
			Cover="{Binding Cover, ElementName=Root}"
			Title="{Binding Title}"
			Author="{Binding Author}"
			Narrator="{Binding Narrator}"
			Duration="{Binding Duration}"
			Status="{Binding Status}"
			StatusText="{Binding StatusText}"
			IsSelected="{Binding IsSelected}"
			ShowOpenAction="False"
			Command="{Binding OpenCommand, ElementName=Root}"
			ContextCommand="{Binding ContextCommand, ElementName=Root}" />
		<CheckBox Classes="contemporary"
				  HorizontalAlignment="Left"
				  VerticalAlignment="Top"
				  Margin="8"
				  IsChecked="{Binding IsSelected, Mode=OneWay}"
				  Click="FlightCheckBox_Click"
				  AutomationProperties.Name="{x:Static properties:Resources.GalleryBookCardAddOrRemoveTitleFromCurrentFlight}"
				  AutomationProperties.HelpText="{x:Static properties:Resources.GalleryBookCardThisCheckboxChangesOnlyThisTitleAnd}" />
		<TextBlock Grid.Row="1"
				   Text="{Binding SelectionText}"
				   FontWeight="SemiBold"
				   Foreground="{DynamicResource Libation.Brush.TextPrimary}"
				   HorizontalAlignment="Center"
				   Margin="0,4,0,0"
				   MinHeight="18" />
	</Grid>
</UserControl>
