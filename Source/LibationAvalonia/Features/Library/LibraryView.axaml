<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="using:LibationAvalonia.Properties"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 xmlns:designSystem="using:LibationAvalonia.DesignSystem"
			 xmlns:library="using:LibationAvalonia.Features.Library"
			 xmlns:views="using:LibationAvalonia.Views"
			 x:Class="LibationAvalonia.Features.Library.LibraryView"
			 x:DataType="library:LibraryViewModel">
	<Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Libation.Space.3}">
		<Border Classes="card" Padding="{DynamicResource Libation.Thickness.4}">
			<Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource Libation.Space.2}">
				<TextBlock Text="{Binding RouteEyebrow}"
						   Foreground="{DynamicResource Libation.Brush.AccentSecondary}"
						   FontSize="{DynamicResource Libation.FontSize.Caption}"
						   FontWeight="SemiBold" />
				<WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="{Binding RouteTitle}"
							   FontFamily="{DynamicResource Libation.Font.Display}"
							   FontSize="{DynamicResource Libation.FontSize.Page}"
							   Foreground="{DynamicResource Libation.Brush.TextPrimary}"
							   TextWrapping="Wrap" />
					<components:StatusBadge Margin="12,0,0,0"
									Status="{Binding RouteStatusBadge.Status}"
									TextOverride="{Binding RouteStatusBadge.Text}"
									AccessibleName="{Binding RouteStatusBadge.Text}" />
				</WrapPanel>
				<TextBlock Grid.Row="2" Text="{Binding RouteSubtitle}"
						   Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
				<Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Libation.Space.2}">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
					<TextBox x:Name="SearchBox"
							 Classes="contemporary search"
							 PlaceholderText="{x:Static properties:Resources.LibraryViewSearchTitlesAuthorsNarratorsSeriesTagsOr}"
							 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							 AutomationProperties.Name="{x:Static properties:Resources.LibraryViewSearchAndFilterTheLibrary}" />
					<Button Grid.Column="1" Classes="contemporary quiet compact" Content="{x:Static properties:Resources.LibraryViewClear}" Command="{Binding ClearSearchCommand}"
							AutomationProperties.Name="{x:Static properties:Resources.LibraryViewClearLibrarySearch}" />
					<Menu Grid.Column="2" Background="Transparent">
						<MenuItem Header="{x:Static properties:Resources.LibraryViewQuickFilters}" ItemsSource="{Binding QuickFilterMenuItems}" />
					</Menu>
				</Grid>
				<WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Button x:Name="FilterHelpButton" Classes="contemporary quiet compact" Content="{x:Static properties:Resources.LibraryViewFilterHelp}" Command="{Binding OpenFilterHelpCommand}" Margin="0,0,8,8" />
					<ComboBox Width="190"
							  Margin="0,0,8,8"
							  ItemsSource="{Binding SortOptions}"
							  SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
							  AutomationProperties.Name="{x:Static properties:Resources.LibraryViewSortLibrary}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="library:LibrarySortOption">
								<TextBlock Text="{Binding Label}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<Button Classes="contemporary compact" Content="{x:Static properties:Resources.LibraryViewDetails}" Command="{Binding ShowDetailsCommand}" Margin="0,0,4,8" />
					<Button Classes="contemporary compact" Content="{x:Static properties:Resources.LibraryViewGallery}" Command="{Binding ShowGalleryCommand}" Margin="0,0,8,8" />
					<Button Classes="contemporary quiet compact" Content="{x:Static properties:Resources.LibraryViewColumns}" Click="ColumnChooser_Click" Margin="0,0,8,8"
							IsVisible="{Binding IsDetailsMode}" />
					<Button Classes="contemporary quiet compact" Content="{Binding DetailsPaneToggleText}" Command="{Binding ToggleDetailsPaneCommand}"
							IsEnabled="{Binding HasFocusedItem}" Margin="0,0,8,8" />
					<Button Classes="contemporary quiet compact" Content="{Binding FlightToggleText}" Command="{Binding ToggleFlightCommand}" Margin="0,0,8,8" />
					<Button Classes="contemporary quiet compact" Content="{x:Static properties:Resources.LibraryViewScan}" Command="{Binding ScanLibraryCommand}" Margin="0,0,8,8" />
					<Button Classes="contemporary quiet compact" Content="{x:Static properties:Resources.LibraryViewAddBooks}" Command="{Binding AddBooksCommand}" Margin="0,0,8,8" />
					<Button Classes="contemporary primary compact" Content="{x:Static properties:Resources.LibraryViewProcessSelected}" Command="{Binding ProcessSelectionCommand}"
							IsEnabled="{Binding HasSelection}" Margin="0,0,0,8" />
				</WrapPanel>
				</Grid>
			</Grid>
		</Border>

		<SplitView Grid.Row="1"
				   PanePlacement="Right"
				   DisplayMode="{Binding DetailsPaneDisplayMode}"
				   IsPaneOpen="{Binding ShowDetailsPane, Mode=OneWay}"
				   OpenPaneLength="360"
				   CompactPaneLength="0">
			<SplitView.Pane>
				<library:BookDetailsPane x:Name="DetailsPane" DataContext="{Binding}" Margin="12,0,0,0" />
			</SplitView.Pane>
			<Grid>
					<Grid IsVisible="{Binding HasResults}">
						<Grid IsVisible="{Binding IsDetailsMode}">
							<views:ProductsDisplay x:Name="DetailsDisplay"
								Classes="contemporary"
								DoubleTapped="DetailsDisplay_DoubleTapped"
								DataContext="{Binding Products, Mode=OneTime}" />
					</Grid>
					<Grid IsVisible="{Binding IsGalleryMode}">
						<library:LibraryGalleryView x:Name="GalleryDisplay"
							DataContext="{Binding}" />
					</Grid>
				</Grid>

				<Border IsVisible="{Binding IsLoading}" Classes="card" Padding="32">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
						<ProgressBar IsIndeterminate="True" Width="240" AutomationProperties.Name="{x:Static properties:Resources.LibraryViewLoadingLibrary}" />
						<TextBlock Text="{x:Static properties:Resources.LibraryViewLoadingYourLibrary}" />
					</StackPanel>
				</Border>

				<components:EmptyState
					IsVisible="{Binding ShowEmptyLibrary}"
					Title="{Binding EmptyTitle}"
					Explanation="{Binding EmptyExplanation}"
					PrimaryActionText="{Binding EmptyPrimaryText}"
					PrimaryCommand="{Binding EmptyPrimaryCommand}"
					SecondaryActionText="{Binding EmptySecondaryText}"
					SecondaryCommand="{Binding OpenTrashCommand}"
					IllustrationTemplate="{DynamicResource illustration.library.empty}" />

				<StackPanel IsVisible="{Binding ShowNoResults}" VerticalAlignment="Center" Spacing="12">
					<components:EmptyState
						Title="{x:Static properties:Resources.LibraryViewNoLibraryResults}"
						Explanation="{Binding NoResultsText}"
						PrimaryActionText="{x:Static properties:Resources.LibraryViewClearSearch}"
						PrimaryCommand="{Binding ClearSearchCommand}"
						SecondaryActionText="{x:Static properties:Resources.LibraryViewFilterHelp}"
						SecondaryCommand="{Binding OpenFilterHelpCommand}"
					IllustrationTemplate="{StaticResource illustration.shared.no-search-results}" />
					<TextBlock IsVisible="{Binding ShowNoResultsTrashHint}"
							   Text="{Binding NoResultsTrashHint}"
							   TextAlignment="Center"
							   TextWrapping="Wrap"
							   Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
				</StackPanel>
			</Grid>
		</SplitView>
	</Grid>
</UserControl>
