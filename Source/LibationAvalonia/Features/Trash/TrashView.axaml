<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="using:LibationAvalonia.Properties"
	xmlns:trash="using:LibationAvalonia.Features.Trash"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:designSystem="using:LibationAvalonia.DesignSystem"
	x:Class="LibationAvalonia.Features.Trash.TrashView"
	x:DataType="trash:TrashViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="TrashRow" x:DataType="trash:TrashItemViewModel">
			<Border Classes="card" Margin="0,0,0,8">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<CheckBox IsVisible="{Binding CanSelect}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
						VerticalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}"
						AutomationProperties.HelpText="{x:Static properties:Resources.TrashViewSelectionChangesOnlyWhichExistingTrashRecord}" />
					<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
							Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
						<TextBlock Text="{Binding CreatorText}" IsVisible="{Binding CreatorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
							Foreground="{DynamicResource Libation.Brush.TextTertiary}" />
					</StackPanel>
					<components:StatusBadge Grid.Column="2" Status="{Binding Status}" TextOverride="{Binding StatusText}"
						AccessibleName="{Binding StatusText}" />
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<Grid Margin="{DynamicResource Libation.Thickness.4}" RowDefinitions="Auto,Auto,*,Auto"
		RowSpacing="{DynamicResource Libation.Space.3}">
		<components:AttentionBanner Grid.Row="0" IsVisible="{Binding HasError}" Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
			Title="{x:Static properties:Resources.TrashViewTrashUnavailable}" Message="{Binding ErrorMessage}"
			ActionText="{x:Static properties:Resources.DownloadsViewRefresh}" ActionCommand="{Binding RefreshCommand}"
			SecondaryActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}" SecondaryActionCommand="{Binding CopyTechnicalDetailsCommand}" />

		<Border Grid.Row="1" Classes="card">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
				<StackPanel Spacing="{DynamicResource Libation.Space.1}">
					<TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{x:Static properties:Resources.TrashViewSearchRemovedTitleCreatorSeriesOrAudible}"
						AutomationProperties.Name="{x:Static properties:Resources.TrashViewSearchTrash}" />
					<TextBlock Text="{Binding ResultSummary}" Foreground="{DynamicResource Libation.Brush.TextSecondary}"
						AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}" />
				</StackPanel>
				<Button Grid.Column="1" Classes="contemporary quiet" Content="{x:Static properties:Resources.DownloadsViewRefresh}" Command="{Binding RefreshCommand}"
					AutomationProperties.Name="{x:Static properties:Resources.TrashViewRefreshTrash}" />
			</Grid>
		</Border>

		<Grid Grid.Row="2">
			<Border Classes="card" IsVisible="{Binding IsLoading}" VerticalAlignment="Top">
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBlock Text="{x:Static properties:Resources.TrashViewLoadingTrash}" FontWeight="SemiBold" />
					<ProgressBar IsIndeterminate="True" AutomationProperties.Name="{x:Static properties:Resources.TrashViewLoadingTrash2}" />
				</StackPanel>
			</Border>
			<components:EmptyState IsVisible="{Binding ShowEmpty}" VerticalAlignment="Top" Title="{x:Static properties:Resources.TrashViewTrashIsEmpty}"
				Explanation="{x:Static properties:Resources.TrashViewTitlesMovedOutOfTheLibraryAppear}"
				PrimaryActionText="{x:Static properties:Resources.TrashViewRefreshTrash}" PrimaryCommand="{Binding RefreshCommand}" />
			<components:EmptyState IsVisible="{Binding ShowNoMatches}" VerticalAlignment="Top" Title="{x:Static properties:Resources.TrashViewNoRemovedTitlesMatch}"
				Explanation="{x:Static properties:Resources.TrashViewClearOrChangeTheCurrentTrashSearch}"
				PrimaryActionText="{x:Static properties:Resources.TrashViewRefreshTrash}" PrimaryCommand="{Binding RefreshCommand}" />
			<ListBox ItemsSource="{Binding VisibleItems}" ItemTemplate="{StaticResource TrashRow}"
				IsVisible="{Binding HasVisibleItems}" AutomationProperties.Name="{x:Static properties:Resources.TrashViewRemovedLibraryRecords}"
				BorderThickness="0">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding" Value="0" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
				</ListBox.ItemsPanel>
			</ListBox>
		</Grid>

		<Border Grid.Row="3" Classes="card" IsVisible="{Binding HasItems}">
			<Grid RowDefinitions="Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}"
				RowSpacing="{DynamicResource Libation.Space.1}">
				<StackPanel Spacing="{DynamicResource Libation.Space.1}">
					<TextBlock Text="{Binding SelectedCountText}" FontWeight="SemiBold" />
					<TextBlock Text="{x:Static properties:Resources.TrashViewPermanentDeletionRemovesLibationRecordsNotAudiobook}"
						TextWrapping="Wrap" FontSize="{DynamicResource Libation.FontSize.Caption}"
						Foreground="{DynamicResource Libation.Brush.Warning}" />
					<TextBlock Text="{Binding LastActionText}" IsVisible="{Binding LastActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
						TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}"
						AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}" />
				</StackPanel>
				<Button Grid.Column="1" Classes="contemporary" Content="{x:Static properties:Resources.TrashViewRestore}" Command="{Binding RestoreSelectedCommand}"
					IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{Binding RestoreActionAccessibleName}" />
				<Button Grid.Column="2" Classes="contemporary danger" Content="{x:Static properties:Resources.TrashViewPermanentlyDelete}" Command="{Binding PermanentlyDeleteSelectedCommand}"
					IsEnabled="{Binding HasSelection}" AutomationProperties.Name="{Binding DeleteActionAccessibleName}"
					AutomationProperties.HelpText="{x:Static properties:Resources.TrashViewAConfirmationDefaultsToCancelAndExplains}" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
