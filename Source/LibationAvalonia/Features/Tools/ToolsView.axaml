<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:tools="using:LibationAvalonia.Features.Tools"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:properties="using:LibationAvalonia.Properties"
	x:Class="LibationAvalonia.Features.Tools.ToolsView"
	x:DataType="tools:ToolsViewModel">
	<UserControl.Styles>
		<Style Selector="Border.tool-risk">
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceInteractive}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.BorderStrong}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource Libation.Radius.Large}" />
			<Setter Property="Padding" Value="8,4" />
		</Style>
		<Style Selector="Border.tool-risk.readonly"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Success}" /></Style>
		<Style Selector="Border.tool-risk.review"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Warning}" /></Style>
		<Style Selector="Border.tool-risk.datachange"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Info}" /></Style>
		<Style Selector="Border.tool-risk.destructive"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Danger}" /></Style>
	</UserControl.Styles>
	<UserControl.Resources>
		<DataTemplate x:Key="ToolAction" x:DataType="tools:ToolActionItem">
			<Border Classes="card" Margin="0,0,0,8">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
						<TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<TextBlock Text="{Binding StateText}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextTertiary}"
							IsVisible="{Binding StateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</StackPanel>
					<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.2}" HorizontalAlignment="Right">
						<Border Classes="tool-risk" Classes.readonly="{Binding IsReadOnlyRisk}" Classes.review="{Binding IsReviewRisk}"
							Classes.datachange="{Binding IsDataChangeRisk}" Classes.destructive="{Binding IsDestructiveRisk}"
							Classes.external="{Binding IsExternalRisk}" AutomationProperties.Name="{Binding RiskText}">
							<TextBlock Text="{Binding RiskText}" FontSize="{DynamicResource Libation.FontSize.Caption}" FontWeight="SemiBold" />
						</Border>
						<Button Classes="contemporary" Content="{Binding ActionText}" Command="{Binding Command}" HorizontalAlignment="Right"
							AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Consequence}" />
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="ToolGroup" x:DataType="tools:ToolActionGroup">
			<StackPanel Spacing="{DynamicResource Libation.Space.3}" Margin="0,0,0,16">
				<StackPanel Spacing="{DynamicResource Libation.Space.1}">
					<TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Libation.Font.Display}"
						FontSize="{DynamicResource Libation.FontSize.Section}" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
					<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
				</StackPanel>
				<ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ToolAction}" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="{DynamicResource Libation.Thickness.5}" Spacing="{DynamicResource Libation.Space.4}">
			<components:AttentionBanner IsVisible="{Binding HasError}" Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
				Title="{x:Static properties:Resources.ToolsViewToolActionUnavailable}" Message="{Binding ErrorMessage}"
				ActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}" ActionCommand="{Binding CopyTechnicalDetailsCommand}" />
			<components:AttentionBanner Severity="{x:Static components:ComponentSeverity.Warning}" Title="{x:Static properties:Resources.ToolsViewTheCurrentLibraryFilterDefinesVisibleTitle}"
				Message="{x:Static properties:Resources.ToolsViewCommandsThatSayVisibleTitlesOperateOn}" />
			<Border Classes="card raised">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.4}">
					<StackPanel Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="{x:Static properties:Resources.ToolsViewApplyTheFirstSavedQuickFilterAt}" FontWeight="SemiBold"
							Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
						<TextBlock Text="{x:Static properties:Resources.ToolsViewControlsOnlyTheFilterLibationAppliesWhen}"
							TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<TextBlock Text="{Binding StartupFilterStateText}" TextWrapping="Wrap"
							Foreground="{DynamicResource Libation.Brush.TextTertiary}" />
					</StackPanel>
					<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.2}" HorizontalAlignment="Right">
						<components:StatusBadge Status="{Binding StartupFilterStatus}" TextOverride="{Binding StartupFilterBadgeText}"
							AccessibleName="{Binding StartupFilterStateText}" />
						<ToggleSwitch IsChecked="{Binding FirstFilterIsDefault, Mode=TwoWay}" HorizontalAlignment="Right"
							AutomationProperties.Name="{x:Static properties:Resources.ToolsViewApplyTheFirstSavedQuickFilterAt}"
							AutomationProperties.HelpText="{x:Static properties:Resources.ToolsViewChangesOnlyTheStartupQuickFilterPreference}" />
					</StackPanel>
				</Grid>
			</Border>
			<ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource ToolGroup}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
