<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:accounts="using:LibationAvalonia.Features.Accounts"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:properties="using:LibationAvalonia.Properties"
	x:Class="LibationAvalonia.Features.Accounts.AccountsView"
	x:DataType="accounts:AccountsViewModel">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="{DynamicResource Libation.Thickness.5}" Spacing="{DynamicResource Libation.Space.4}">
			<components:AttentionBanner IsVisible="{Binding HasError}" Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
				Title="Account action unavailable" Message="{Binding ErrorMessage}"
				ActionText="Copy technical details" ActionCommand="{Binding CopyTechnicalDetailsCommand}" />

			<Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource Libation.Space.4}">
				<Border Classes="card raised">
					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<TextBlock Text="Connection summary" FontFamily="{DynamicResource Libation.Font.Display}" FontSize="{DynamicResource Libation.FontSize.Section}" />
						<TextBlock Text="{Binding AccountCountText}" FontWeight="SemiBold" />
						<TextBlock Text="{Binding LibraryTitleCountText}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<TextBlock Text="{Binding AuthorizationSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Classes="contemporary primary" Content="Manage accounts" Command="{Binding ManageAccountsCommand}" />
							<Button Classes="contemporary" Content="Add account" Command="{Binding AddAccountCommand}" />
						</StackPanel>
					</StackPanel>
				</Border>
				<Border Grid.Column="1" Classes="card raised">
					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<TextBlock Text="Library scan" FontFamily="{DynamicResource Libation.Font.Display}" FontSize="{DynamicResource Libation.FontSize.Section}" />
						<TextBlock Text="{Binding ScanStateText}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Classes="contemporary primary" Content="Scan all accounts" Command="{Binding ScanAllCommand}" IsEnabled="{Binding CanScan}" />
							<Button Classes="contemporary" Content="Choose accounts to scan" Command="{Binding ScanSomeCommand}"
								IsEnabled="{Binding CanScanSome}" />
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>

			<Border Classes="card">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="Automatic scanning" FontWeight="SemiBold" />
						<TextBlock Text="{Binding AutoScanText}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					</StackPanel>
					<Button Grid.Column="1" Classes="contemporary" Content="{Binding AutoScanActionText}" Command="{Binding ToggleAutoScanCommand}" />
				</Grid>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<TextBlock Text="Review titles missing from account scans" FontFamily="{DynamicResource Libation.Font.Display}"
						FontSize="{DynamicResource Libation.FontSize.Section}" />
					<TextBlock Text="{x:Static properties:Resources.AccountsReconcileExplanation}"
						TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					<components:AttentionBanner Severity="{x:Static components:ComponentSeverity.Warning}" Title="Review before removing records"
						Message="Moving a library record to Trash hides it from the library. Restore and permanent record deletion remain in the protected Trash workflow." />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Classes="contemporary" Content="Review all accounts" Command="{Binding ReconcileAllCommand}" IsEnabled="{Binding CanScan}" />
						<Button Classes="contemporary" Content="Choose accounts to review" Command="{Binding ReconcileSomeCommand}"
							IsEnabled="{Binding CanScanSome}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
