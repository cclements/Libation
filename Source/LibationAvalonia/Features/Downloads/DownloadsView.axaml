<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="using:LibationAvalonia.Properties"
	xmlns:downloads="using:LibationAvalonia.Features.Downloads"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	x:Class="LibationAvalonia.Features.Downloads.DownloadsView"
	x:DataType="downloads:DownloadsViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="DownloadsRow" x:DataType="downloads:DownloadsListRowViewModel">
			<Grid>
				<Border IsVisible="{Binding IsSectionHeader}" Margin="0,12,0,8" Padding="4,0"
					AutomationProperties.Name="{Binding SectionText}">
					<TextBlock Text="{Binding SectionText}" FontFamily="{DynamicResource Libation.Font.Display}"
						FontSize="{DynamicResource Libation.FontSize.Section}" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
				</Border>
				<components:BookRow IsVisible="{Binding IsBookRow}" Margin="0,0,0,8"
					Title="{Binding Book.Title}" SupportingText="{Binding Book.SupportingText}" Metadata="{Binding Book.Metadata}"
					Status="{Binding Book.Status}" StatusText="{Binding Book.StatusText}"
					StatusAccessibleName="{Binding Book.StatusAccessibleName}"
					ShowProgress="{Binding Book.ShowProgress}" Progress="{Binding Book.Progress}"
					ProgressAccessibleName="{Binding Book.ProgressAccessibleName}"
					Command="{Binding Book.PrimaryCommand}" CommandText="{Binding Book.PrimaryActionText}"
					CommandAccessibleName="{Binding Book.PrimaryAccessibleName}"
					ContextCommand="{Binding Book.LocateCommand}" ContextCommandText="{x:Static properties:Resources.DownloadsViewLocate}"
					ContextCommandAccessibleName="{Binding Book.LocateAccessibleName}" />
			</Grid>
		</DataTemplate>
	</UserControl.Resources>
	<Grid Margin="{DynamicResource Libation.Thickness.5}" RowDefinitions="Auto,*"
		RowSpacing="{DynamicResource Libation.Space.3}">
		<components:AttentionBanner Grid.Row="0" IsVisible="{Binding HasError}"
			Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True" Title="{x:Static properties:Resources.DownloadsViewDownloadActionUnavailable}"
			Message="{Binding ErrorMessage}" ActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}" ActionCommand="{Binding CopyTechnicalDetailsCommand}" />
		<Grid Grid.Row="1">
			<Border Classes="card" IsVisible="{Binding IsLoading}" VerticalAlignment="Top">
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBlock Text="{x:Static properties:Resources.DownloadsViewLoadingPerTitleDownloadState}" FontWeight="SemiBold" />
					<ProgressBar IsIndeterminate="True" AutomationProperties.Name="{x:Static properties:Resources.DownloadsViewLoadingPerTitleDownloadState2}" />
				</StackPanel>
			</Border>
			<components:EmptyState IsVisible="{Binding ShowEmptyLibrary}" VerticalAlignment="Top" Title="{x:Static properties:Resources.DownloadsViewNoCataloguedTitlesYet}"
				Explanation="{Binding EmptyLibraryExplanation}" PrimaryActionText="{Binding EmptyLibraryActionText}"
				PrimaryCommand="{Binding EmptyLibraryCommand}" SecondaryActionText="{x:Static properties:Resources.DownloadsViewRefresh}"
				SecondaryCommand="{Binding RefreshCommand}" />
			<ListBox ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DownloadsRow}"
				IsVisible="{Binding HasLibraryTitles}" AutomationProperties.Name="{x:Static properties:Resources.DownloadsViewDownloadsGroupedByTitle}"
				BorderThickness="0">
				<ListBox.Styles>
					<Style Selector="ListBoxItem">
						<Setter Property="Padding" Value="0" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListBox.Styles>
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
				</ListBox.ItemsPanel>
			</ListBox>
		</Grid>
	</Grid>
</UserControl>
