<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:settings="using:LibationAvalonia.Features.Settings"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:fileManager="using:LibationFileManager"
	xmlns:properties="using:LibationAvalonia.Properties"
	x:Class="LibationAvalonia.Features.Settings.SettingsView"
	x:DataType="settings:SettingsViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="SettingsCategory" x:DataType="settings:SettingsCategoryItem">
			<Border Classes="card" Margin="0,0,0,8">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
						<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					</StackPanel>
					<Button Grid.Column="1" Classes="contemporary" Content="{Binding ActionLabel}" Command="{Binding OpenCommand}"
						AutomationProperties.Name="{Binding ActionLabel}" />
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="{DynamicResource Libation.Thickness.5}" Spacing="{DynamicResource Libation.Space.4}">
			<components:AttentionBanner IsVisible="{Binding HasError}" Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
				Title="{x:Static properties:Resources.SettingsViewSettingsActionUnavailable}" Message="{Binding ErrorMessage}"
				ActionText="{x:Static properties:Resources.AccountsViewCopyTechnicalDetails}" ActionCommand="{Binding CopyTechnicalDetailsCommand}" />

			<Border Classes="card raised">
				<StackPanel Spacing="{DynamicResource Libation.Space.4}">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
						<StackPanel Spacing="{DynamicResource Libation.Space.1}">
							<TextBlock Text="{x:Static properties:Resources.SettingsViewAppearance}" FontFamily="{DynamicResource Libation.Font.Display}"
								FontSize="{DynamicResource Libation.FontSize.Section}" />
							<TextBlock Text="{Binding AppearanceSummary}" TextWrapping="Wrap"
								Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						</StackPanel>
						<components:StatusBadge Grid.Column="1" Status="{x:Static components:LibationStatusKind.Completed}"
							TextOverride="{Binding AppearanceProfileText}" AccessibleName="{Binding AppearanceProfileText}" />
					</Grid>

					<StackPanel Spacing="{DynamicResource Libation.Space.3}">
						<settings:AppearanceProfilePreview
							ProfileStyle="{x:Static fileManager:ExperienceStyle.Cellar}"
							ProfileName="{x:Static properties:Resources.OnboardingViewCellar}"
							Description="{x:Static properties:Resources.SettingsViewAFocusedDarkWorkspaceWithTheCellar}"
							SelectCommand="{Binding Appearance.SelectCellarCommand}"
							IsSelected="{Binding Appearance.IsCellarSelected}"
							Density="{Binding Appearance.Density}"
							Decoration="{Binding Appearance.Decoration}"
							Motion="{Binding Appearance.Motion}"
							UseSystemTypography="{Binding Appearance.UseSystemTypography}" />
						<settings:AppearanceProfilePreview
							ProfileStyle="{x:Static fileManager:ExperienceStyle.TastingRoom}"
							ProfileName="{x:Static properties:Resources.OnboardingViewTastingRoom}"
							Description="{x:Static properties:Resources.SettingsViewABrightEditorialWorkspaceWithTheTasting}"
							SelectCommand="{Binding Appearance.SelectTastingRoomCommand}"
							IsSelected="{Binding Appearance.IsTastingRoomSelected}"
							Density="{Binding Appearance.Density}"
							Decoration="{Binding Appearance.Decoration}"
							Motion="{Binding Appearance.Motion}"
							UseSystemTypography="{Binding Appearance.UseSystemTypography}" />
					</StackPanel>

					<Border Classes="card">
						<StackPanel Spacing="{DynamicResource Libation.Space.3}">
							<CheckBox Content="{x:Static properties:Resources.SettingsViewUseHighContrast}" IsChecked="{Binding Appearance.IsHighContrast, Mode=TwoWay}"
								AutomationProperties.Name="{x:Static properties:Resources.SettingsViewUseHighContrast}" />
							<TextBlock Text="{x:Static properties:Resources.SettingsViewHighContrastIsAnExclusiveProfileTurning}"
								TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />

							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.SettingsViewProfileBehavior}" FontWeight="SemiBold" />
								<ComboBox ItemsSource="{Binding Appearance.BaseStyles}" SelectedItem="{Binding Appearance.SelectedBaseStyle, Mode=TwoWay}"
									HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewContemporaryProfileBehavior}" />
							</StackPanel>
							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.SettingsViewDensity}" FontWeight="SemiBold" />
								<ComboBox ItemsSource="{Binding Appearance.DensityModes}" SelectedItem="{Binding Appearance.SelectedDensityMode, Mode=TwoWay}"
									HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewContemporaryDensity}" />
							</StackPanel>
							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.SettingsViewDecoration}" FontWeight="SemiBold" />
								<ComboBox ItemsSource="{Binding Appearance.DecorationLevels}" SelectedItem="{Binding Appearance.SelectedDecorationLevel, Mode=TwoWay}"
									HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewContemporaryDecoration}" />
							</StackPanel>
							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.SettingsViewMotion}" FontWeight="SemiBold" />
								<ComboBox ItemsSource="{Binding Appearance.MotionPreferences}" SelectedItem="{Binding Appearance.SelectedMotionPreference, Mode=TwoWay}"
									HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewContemporaryMotion}" />
							</StackPanel>
							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.SettingsViewDefaultLibraryView}" FontWeight="SemiBold" />
								<ComboBox ItemsSource="{Binding Appearance.LibraryViews}" SelectedItem="{Binding Appearance.SelectedLibraryView, Mode=TwoWay}"
									HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewDefaultContemporaryLibraryView}" />
							</StackPanel>
							<StackPanel Spacing="{DynamicResource Libation.Space.1}">
								<TextBlock Text="{x:Static properties:Resources.SettingsViewNavigationRail}" FontWeight="SemiBold" />
								<ComboBox ItemsSource="{Binding Appearance.NavigationRails}" SelectedItem="{Binding Appearance.SelectedNavigationRail, Mode=TwoWay}"
									HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewContemporaryNavigationRail}" />
							</StackPanel>

							<CheckBox Content="{x:Static properties:Resources.SettingsViewUseSystemTypography}" IsChecked="{Binding Appearance.UseSystemTypography, Mode=TwoWay}"
								AutomationProperties.Name="{x:Static properties:Resources.SettingsViewUseSystemTypography}" />
							<CheckBox Content="{x:Static properties:Resources.SettingsViewShowTheDecanterProcessingDockWhenSpace}"
								IsChecked="{Binding Appearance.ShowDecanterDock, Mode=TwoWay}"
								AutomationProperties.Name="{x:Static properties:Resources.SettingsViewShowTheDecanterProcessingDockWhenSpace}" />
							<CheckBox Content="{x:Static properties:Resources.SettingsViewRestoreCurrentFlightAfterRestartingLibation}"
								IsChecked="{Binding Appearance.PersistFlightBetweenSessions, Mode=TwoWay}"
								AutomationProperties.Name="{x:Static properties:Resources.SettingsViewRestoreCurrentFlightAfterRestartingLibation}" />
						</StackPanel>
					</Border>

					<TextBlock Text="{Binding Appearance.DraftStateText}" TextWrapping="Wrap"
						Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					<TextBlock Text="{Binding LegacyThemeSummary}" TextWrapping="Wrap"
						Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					<WrapPanel Orientation="Horizontal">
						<Button Classes="contemporary primary" Margin="0,0,8,8" Content="{x:Static properties:Resources.SettingsViewApplyAppearance}"
							Command="{Binding ApplyAppearanceCommand}" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewApplyAppearanceSettings}" />
						<Button Classes="contemporary" Margin="0,0,8,8" Content="{x:Static properties:Resources.SettingsViewResetAppearance}"
							Command="{Binding ResetAppearanceCommand}" AutomationProperties.Name="{x:Static properties:Resources.SettingsViewResetAppearanceToDefaults}" />
						<Button Classes="contemporary" Margin="0,0,8,8" Content="{x:Static properties:Resources.SettingsViewRunProfileChooserAgain}"
							Command="{Binding RequestOnboardingCommand}" />
					</WrapPanel>
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{x:Static properties:Resources.SettingsViewSearchSettingsTabs}"
						AutomationProperties.Name="{x:Static properties:Resources.SettingsViewSearchSettingsTabs}" />
					<TextBlock Text="{Binding CategorySummary}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
				</StackPanel>
			</Border>
			<components:EmptyState IsVisible="{Binding !HasCategories}" Title="{x:Static properties:Resources.SettingsViewNoSettingsTabsMatch}"
				Explanation="{x:Static properties:Resources.SettingsEmptyExplanation}" PrimaryActionText="{x:Static properties:Resources.OnboardingViewOpenSettings}"
				PrimaryCommand="{Binding OpenSettingsCommand}" />
			<ItemsControl ItemsSource="{Binding VisibleCategories}" ItemTemplate="{StaticResource SettingsCategory}" />

			<Border Classes="card">
				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<TextBlock Text="{x:Static properties:Resources.SettingsViewAccountsAboutAndUpdates}" FontWeight="SemiBold" />
					<TextBlock Text="{x:Static properties:Resources.SettingsViewAccountIdentitiesRemainInTheProtectedAccount}"
						TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					<WrapPanel Orientation="Horizontal">
						<Button Classes="contemporary" Margin="0,0,8,8" Content="{x:Static properties:Resources.OnboardingViewManageAccounts}" Command="{Binding OpenAccountsCommand}" />
						<Button Classes="contemporary" Margin="0,0,8,8" Content="{x:Static properties:Resources.SettingsViewAboutAndUpdates}" Command="{Binding OpenAboutCommand}" />
					</WrapPanel>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
