<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:settings="using:LibationAvalonia.Features.Settings"
	xmlns:components="using:LibationAvalonia.DesignSystem.Components"
	xmlns:properties="using:LibationAvalonia.Properties"
	x:Class="LibationAvalonia.Features.Settings.SettingsView"
	x:DataType="settings:SettingsViewModel">
	<UserControl.Resources>
		<DataTemplate x:Key="SettingsCategory" x:DataType="settings:SettingsCategoryItem">
			<Border Classes="card" Margin="0,0,0,8">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
						<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					</StackPanel>
					<Button Grid.Column="1" Classes="contemporary" Content="{Binding ActionLabel}" Command="{Binding OpenCommand}" />
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.Resources>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="{DynamicResource Libation.Thickness.5}" Spacing="{DynamicResource Libation.Space.4}">
			<components:PageHeader Eyebrow="Preferences" Title="Settings"
				SupportingText="{x:Static properties:Resources.SettingsSupportingText}"
				PrimaryActionText="Open Settings" PrimaryCommand="{Binding OpenSettingsCommand}" />
			<components:AttentionBanner IsVisible="{Binding HasError}" Severity="{x:Static components:ComponentSeverity.Danger}" FocusOnShow="True"
				Title="Settings action unavailable" Message="{Binding ErrorMessage}"
				ActionText="Copy technical details" ActionCommand="{Binding CopyTechnicalDetailsCommand}" />

			<Border Classes="card raised">
				<StackPanel Spacing="{DynamicResource Libation.Space.3}">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
						<StackPanel Spacing="{DynamicResource Libation.Space.1}">
							<TextBlock Text="Appearance" FontFamily="{DynamicResource Libation.Font.Display}" FontSize="{DynamicResource Libation.FontSize.Section}" />
							<TextBlock Text="{Binding AppearanceSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
						</StackPanel>
						<components:StatusBadge Grid.Column="1" Status="{x:Static components:LibationStatusKind.Completed}"
							TextOverride="{Binding AppearanceProfileText}" AccessibleName="{Binding AppearanceProfileText}" />
					</Grid>
					<UniformGrid Columns="3" Rows="0">
						<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.settings}"
							Value="{Binding DensityText}" Label="Density" />
						<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.settings}"
							Value="{Binding DecorationText}" Label="Decoration" />
						<components:MetricCard Margin="0,0,8,8" IconData="{StaticResource glyph.settings}"
							Value="{Binding MotionText}" Label="Motion" />
					</UniformGrid>
					<TextBlock Text="{Binding LegacyThemeSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Classes="contemporary primary" Content="Edit appearance and settings" Command="{Binding OpenSettingsCommand}" />
						<Button Classes="contemporary" Content="Run profile chooser again" Command="{Binding RequestOnboardingCommand}" />
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search settings categories"
						AutomationProperties.Name="Search settings categories" />
					<TextBlock Text="{Binding CategorySummary}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
				</StackPanel>
			</Border>
			<components:EmptyState IsVisible="{Binding !HasCategories}" Title="No settings categories match"
				Explanation="{x:Static properties:Resources.SettingsEmptyExplanation}" PrimaryActionText="Open Settings"
				PrimaryCommand="{Binding OpenSettingsCommand}" />
			<ItemsControl ItemsSource="{Binding VisibleCategories}" ItemTemplate="{StaticResource SettingsCategory}" />

			<Border Classes="card">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel Spacing="{DynamicResource Libation.Space.1}">
						<TextBlock Text="Accounts, About, and updates" FontWeight="SemiBold" />
						<TextBlock Text="Account identities remain in the protected account dialog. About owns the current version, release notes, and update check."
							TextWrapping="Wrap" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					</StackPanel>
					<Button Grid.Column="1" Classes="contemporary" Content="Manage accounts" Command="{Binding OpenAccountsCommand}" />
					<Button Grid.Column="2" Classes="contemporary" Content="About and updates" Command="{Binding OpenAboutCommand}" />
				</Grid>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
