<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="Menu.contemporary">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceRaised}" />
		<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextPrimary}" />
	</Style>
	<Style Selector="ContextMenu.contemporary">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceRaised}" />
		<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextPrimary}" />
	</Style>
	<Style Selector="MenuItem.contemporary">
		<Setter Property="MinHeight" Value="{DynamicResource Libation.ControlHeight.Compact}" />
		<Setter Property="Padding" Value="12,6" />
		<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextPrimary}" />
	</Style>
	<Style Selector="MenuItem.contemporary:pointerover">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceInteractive}" />
	</Style>
	<Style Selector="MenuItem.contemporary:focus">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.Selection}" />
	</Style>
</Styles>
