<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="ListBox.contemporary">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style Selector="ListBox.contemporary > ListBoxItem">
		<Setter Property="MinHeight" Value="{DynamicResource Libation.Density.RowHeight}" />
		<Setter Property="Padding" Value="12" />
		<Setter Property="CornerRadius" Value="{DynamicResource Libation.Radius.Small}" />
		<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextPrimary}" />
	</Style>
	<Style Selector="ListBox.contemporary > ListBoxItem:pointerover">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceInteractive}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.BorderSubtle}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="ListBox.contemporary > ListBoxItem:pressed">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.AccentPressed}" />
		<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextOnAccent}" />
	</Style>
	<Style Selector="ListBox.contemporary > ListBoxItem:selected">
		<Setter Property="Background" Value="{DynamicResource Libation.Brush.Selection}" />
		<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextOnAccent}" />
		<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.AccentPrimary}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="ListBox.contemporary > ListBoxItem:focus-visible">
		<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Focus}" />
		<Setter Property="BorderThickness" Value="2" />
	</Style>
</Styles>
