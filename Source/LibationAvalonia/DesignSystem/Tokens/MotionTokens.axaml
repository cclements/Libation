<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Durations are milliseconds so controls can resolve them through one motion policy. -->
	<x:Double x:Key="Libation.Motion.Duration.Fast">120</x:Double>
	<x:Double x:Key="Libation.Motion.Duration.Default">180</x:Double>
	<x:Double x:Key="Libation.Motion.Duration.Deliberate">260</x:Double>
	<x:Double x:Key="Libation.Motion.Scale">1</x:Double>
</ResourceDictionary>
