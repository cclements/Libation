<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<x:Double x:Key="Libation.Space.1">4</x:Double>
	<x:Double x:Key="Libation.Space.2">8</x:Double>
	<x:Double x:Key="Libation.Space.3">12</x:Double>
	<x:Double x:Key="Libation.Space.4">16</x:Double>
	<x:Double x:Key="Libation.Space.5">24</x:Double>
	<x:Double x:Key="Libation.Space.6">32</x:Double>
	<x:Double x:Key="Libation.Space.7">48</x:Double>
	<x:Double x:Key="Libation.Space.8">64</x:Double>

	<CornerRadius x:Key="Libation.Radius.Small">6</CornerRadius>
	<CornerRadius x:Key="Libation.Radius.Medium">12</CornerRadius>
	<CornerRadius x:Key="Libation.Radius.Large">18</CornerRadius>

	<x:Double x:Key="Libation.ControlHeight.Compact">32</x:Double>
	<x:Double x:Key="Libation.ControlHeight.Default">40</x:Double>
	<x:Double x:Key="Libation.ControlHeight.Prominent">48</x:Double>
	<x:Double x:Key="Libation.Navigation.WidthExpanded">232</x:Double>
	<x:Double x:Key="Libation.Navigation.WidthCompact">64</x:Double>
	<x:Double x:Key="Libation.Content.MaxReadingWidth">920</x:Double>

	<BoxShadows x:Key="Libation.Shadow.Low">0 2 8 0 #24000000</BoxShadows>
	<BoxShadows x:Key="Libation.Shadow.Medium">0 8 24 0 #30000000</BoxShadows>

	<x:Double x:Key="Libation.Density.RowHeight">56</x:Double>
	<Thickness x:Key="Libation.Density.CardPadding">16</Thickness>
	<x:Double x:Key="Libation.Density.ToolbarGap">12</x:Double>
	<x:Double x:Key="Libation.Density.QueueItemHeight">72</x:Double>
	<x:Double x:Key="Libation.Density.MetadataOpacity">1</x:Double>
	<x:Double x:Key="Libation.Decoration.Opacity">1</x:Double>
	<x:Boolean x:Key="Libation.Decoration.Visible">True</x:Boolean>
</ResourceDictionary>
