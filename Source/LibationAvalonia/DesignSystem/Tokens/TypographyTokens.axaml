<ResourceDictionary
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<FontFamily x:Key="Libation.Font.UI">$Default</FontFamily>
	<FontFamily x:Key="Libation.Font.Display">avares://Libation/Assets/Fonts#Source Serif 4, Georgia, Times New Roman, Noto Serif</FontFamily>
	<x:Double x:Key="Libation.FontSize.Caption">12</x:Double>
	<x:Double x:Key="Libation.FontSize.BodySmall">13</x:Double>
	<x:Double x:Key="Libation.FontSize.Body">14</x:Double>
	<x:Double x:Key="Libation.FontSize.BodyStrong">16</x:Double>
	<x:Double x:Key="Libation.FontSize.Section">20</x:Double>
	<x:Double x:Key="Libation.FontSize.Page">34</x:Double>
	<x:Double x:Key="Libation.FontSize.Hero">42</x:Double>
</ResourceDictionary>
