<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 x:Class="LibationAvalonia.DesignSystem.Components.DropZone"
			 x:Name="Root">
	<UserControl.Styles>
		<Style Selector="components|DropZone Border#DropSurface">
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.BorderStrong}" />
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceSunken}" />
		</Style>
		<Style Selector="components|DropZone:drag-over Border#DropSurface">
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.AccentPrimary}" />
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.Selection}" />
		</Style>
	</UserControl.Styles>
	<Border x:Name="DropSurface" BorderThickness="2" CornerRadius="{DynamicResource Libation.Radius.Medium}"
			Padding="24"
			AutomationProperties.Name="{Binding Title, ElementName=Root}"
			AutomationProperties.HelpText="{Binding Hint, ElementName=Root}">
		<StackPanel HorizontalAlignment="Center" Spacing="{DynamicResource Libation.Space.3}">
			<Path Data="{DynamicResource glyph.add-books}" Width="40" Height="40" Stretch="Uniform"
				  Stroke="{DynamicResource Libation.Brush.AccentSecondary}" StrokeThickness="1.75"
				  StrokeLineCap="Round" StrokeJoin="Round"
				  AutomationProperties.IsControlElementOverride="False" AutomationProperties.AccessibilityView="Raw" />
			<TextBlock Text="{Binding Title, ElementName=Root}" FontFamily="{DynamicResource Libation.Font.Display}"
					   FontSize="{DynamicResource Libation.FontSize.Section}" Foreground="{DynamicResource Libation.Brush.TextPrimary}"
					   HorizontalAlignment="Center" />
			<TextBlock Text="{Binding Hint, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextSecondary}"
					   TextWrapping="Wrap" TextAlignment="Center" />
			<TextBlock Text="{Binding AcceptedTypesText, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextTertiary}"
					   FontSize="{DynamicResource Libation.FontSize.Caption}" TextAlignment="Center" />
			<Button Classes="contemporary" Content="Browse" Command="{Binding BrowseCommand, ElementName=Root}"
					CommandParameter="{Binding BrowseCommandParameter, ElementName=Root}" HorizontalAlignment="Center" />
			<TextBlock Text="{Binding ErrorText, ElementName=Root}"
					   IsVisible="{Binding ErrorText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
					   Foreground="{DynamicResource Libation.Brush.Danger}" TextWrapping="Wrap" TextAlignment="Center"
					   AutomationProperties.LiveSetting="Polite" />
		</StackPanel>
	</Border>
</UserControl>
