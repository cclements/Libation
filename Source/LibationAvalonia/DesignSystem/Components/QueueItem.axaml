<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 xmlns:designSystem="using:LibationAvalonia.DesignSystem"
			 x:Class="LibationAvalonia.DesignSystem.Components.QueueItem"
			 x:Name="Root">
	<Border Classes="card" MinHeight="{DynamicResource Libation.Density.QueueItemHeight}"
			AutomationProperties.Name="{Binding AccessibleName, ElementName=Root}">
		<Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource Libation.Space.2}">
			<Expander IsExpanded="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}">
				<Expander.Header>
					<Grid ColumnDefinitions="48,*" ColumnSpacing="{DynamicResource Libation.Space.3}">
						<Grid Width="48" Height="48">
							<Border Background="{DynamicResource Libation.Brush.CoverPlaceholder}"
									CornerRadius="{DynamicResource Libation.Radius.Small}"
									IsVisible="{Binding Cover, ElementName=Root, Converter={x:Static ObjectConverters.IsNull}}">
								<Path Data="{DynamicResource glyph.processing}" Stroke="{DynamicResource Libation.Brush.TextTertiary}"
									  Stretch="Uniform" Width="24" Height="24" StrokeThickness="1.5" />
							</Border>
							<Image Source="{Binding Cover, ElementName=Root}" Stretch="UniformToFill"
								   IsVisible="{Binding Cover, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"
								   AutomationProperties.IsControlElementOverride="False" AutomationProperties.AccessibilityView="Raw" />
						</Grid>
						<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.1}">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
								<TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold"
										   Foreground="{DynamicResource Libation.Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
								<components:StatusBadge Grid.Column="1" Status="{Binding Status, ElementName=Root}"
													TextOverride="{Binding StatusText, ElementName=Root}" />
							</Grid>
							<TextBlock Text="{Binding Author, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
								<TextBlock Text="{Binding Stage, ElementName=Root}"
										   Foreground="{DynamicResource Libation.Brush.AccentPrimary}"
										   AutomationProperties.Name="{Binding StageAccessibleName, ElementName=Root}"
										   AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}" />
								<TextBlock Grid.Column="1" Text="{Binding OutputProfileText, ElementName=Root}"
										   Foreground="{DynamicResource Libation.Brush.TextSecondary}"
										   IsVisible="{Binding OutputProfileText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
							</Grid>
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}"
								  IsVisible="{Binding ShowProgress, ElementName=Root}">
								<ProgressBar Classes="contemporary" Minimum="0" Maximum="100" Value="{Binding Progress, ElementName=Root}"
											 AutomationProperties.Name="{Binding ProgressAccessibleName, ElementName=Root}" />
								<TextBlock Grid.Column="1" Text="{Binding ProgressText, ElementName=Root}" MinWidth="34" HorizontalAlignment="Right" />
								<TextBlock Grid.Column="2" Text="{Binding EtaText, ElementName=Root}" MinWidth="72"
										   Foreground="{DynamicResource Libation.Brush.TextSecondary}"
										   IsVisible="{Binding EtaText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
							</Grid>
						</StackPanel>
					</Grid>
				</Expander.Header>
				<StackPanel Spacing="{DynamicResource Libation.Space.2}">
					<TextBlock Text="{Binding Message, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap"
							   IsVisible="{Binding Message, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					<TextBlock Text="{Binding ErrorDetails, ElementName=Root}"
							   IsVisible="{Binding ErrorDetails, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   Foreground="{DynamicResource Libation.Brush.Danger}" FontWeight="SemiBold" TextWrapping="Wrap" />
					<TextBlock Text="{Binding RecommendedAction, ElementName=Root}"
							   IsVisible="{Binding RecommendedAction, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap" />
					<TextBlock Text="{Binding ReferenceText, ElementName=Root}"
							   IsVisible="{Binding ReferenceText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
							   Foreground="{DynamicResource Libation.Brush.TextTertiary}" FontFamily="monospace" TextWrapping="Wrap" />
				</StackPanel>
			</Expander>
			<WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Classes="contemporary quiet compact" Content="Move up" Margin="4,0,0,0"
						Command="{Binding MoveUpCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding MoveUpAccessibleName, ElementName=Root}"
						IsVisible="{Binding MoveUpCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<Button Classes="contemporary quiet compact" Content="Move down" Margin="4,0,0,0"
						Command="{Binding MoveDownCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding MoveDownAccessibleName, ElementName=Root}"
						IsVisible="{Binding MoveDownCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<Button Classes="contemporary quiet compact" Content="Copy details" Margin="4,0,0,0"
						Command="{Binding CopyTechnicalDetailsCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding CopyDetailsAccessibleName, ElementName=Root}"
						IsVisible="{Binding CopyTechnicalDetailsCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<Button Classes="contemporary quiet compact" Content="Retry" Margin="4,0,0,0"
						Command="{Binding RetryCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding RetryAccessibleName, ElementName=Root}"
						IsVisible="{Binding RetryCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<Button Classes="contemporary quiet compact" Content="Open log" Margin="4,0,0,0"
						Command="{Binding OpenLogCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding OpenLogAccessibleName, ElementName=Root}"
						IsVisible="{Binding OpenLogCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<Button Classes="contemporary quiet compact" Content="Reveal output" Margin="4,0,0,0"
						Command="{Binding RevealCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding RevealAccessibleName, ElementName=Root}"
						IsVisible="{Binding RevealCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
				<Button Classes="contemporary danger compact" Content="Cancel" Margin="4,0,0,0"
						Command="{Binding CancelCommand, ElementName=Root}"
						AutomationProperties.Name="{Binding CancelAccessibleName, ElementName=Root}"
						IsVisible="{Binding CancelCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}" />
			</WrapPanel>
		</Grid>
	</Border>
</UserControl>
