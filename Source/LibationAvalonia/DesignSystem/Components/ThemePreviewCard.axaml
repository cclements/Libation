<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 x:Class="LibationAvalonia.DesignSystem.Components.ThemePreviewCard"
			 x:Name="Root">
	<Border Classes="card raised" AutomationProperties.Name="{Binding ProfileName, ElementName=Root}">
		<StackPanel Spacing="{DynamicResource Libation.Space.3}">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
				<StackPanel Spacing="{DynamicResource Libation.Space.1}">
					<TextBlock Text="{Binding ProfileName, ElementName=Root}" FontFamily="{DynamicResource Libation.Font.Display}"
							   FontSize="{DynamicResource Libation.FontSize.Section}" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
					<TextBlock Text="{Binding Description, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap" />
				</StackPanel>
				<components:StatusBadge Grid.Column="1" Status="{Binding BadgeStatus, ElementName=Root}"
								TextOverride="{Binding BadgeText, ElementName=Root}" />
			</Grid>
			<Border Classes="card selected">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<Border Width="44" Height="56" Background="{DynamicResource Libation.Brush.CoverPlaceholder}"
							CornerRadius="{DynamicResource Libation.Radius.Small}">
						<Path Data="{DynamicResource glyph.library}" Width="22" Height="22" Stretch="Uniform"
							  Stroke="{DynamicResource Libation.Brush.TextTertiary}" StrokeThickness="1.5" />
					</Border>
				<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.1}" VerticalAlignment="Center">
					<TextBlock Text="{Binding SelectedRowTitle, ElementName=Root}" FontWeight="SemiBold"
							   Foreground="{DynamicResource Libation.Brush.TextOnAccent}" />
					<TextBlock Text="{Binding SelectedRowMetadata, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextOnAccent}" />
				</StackPanel>
				</Grid>
			</Border>
			<ProgressBar Classes="contemporary prominent" Minimum="0" Maximum="100" Value="{Binding Progress, ElementName=Root}"
						 AutomationProperties.Name="Theme sample progress" />
			<Button Classes="contemporary primary" Content="{Binding ActionText, ElementName=Root}"
					Command="{Binding ActionCommand, ElementName=Root}" HorizontalAlignment="Left" />
		</StackPanel>
	</Border>
</UserControl>
