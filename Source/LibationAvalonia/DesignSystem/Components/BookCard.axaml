<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 x:Class="LibationAvalonia.DesignSystem.Components.BookCard"
			 x:Name="Root">
	<UserControl.Styles>
		<Style Selector="components|BookCard:selected Border#CardRoot">
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.Selection}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.AccentPrimary}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
	</UserControl.Styles>
	<Border x:Name="CardRoot" Classes="card raised" AutomationProperties.Name="{Binding Title, ElementName=Root}">
		<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{DynamicResource Libation.Space.3}">
			<Grid Height="232">
				<Border Background="{DynamicResource Libation.Brush.CoverPlaceholder}" CornerRadius="{DynamicResource Libation.Radius.Small}"
						IsVisible="{Binding Cover, ElementName=Root, Converter={x:Static ObjectConverters.IsNull}}">
					<Path Data="{DynamicResource glyph.library}" Stretch="Uniform" Width="64" Height="64"
						  Stroke="{DynamicResource Libation.Brush.TextTertiary}" StrokeThickness="1.5"
						  AutomationProperties.IsControlElementOverride="False" AutomationProperties.AccessibilityView="Raw" />
				</Border>
				<Image Source="{Binding Cover, ElementName=Root}" Stretch="UniformToFill"
					   IsVisible="{Binding Cover, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"
					   AutomationProperties.IsControlElementOverride="False" AutomationProperties.AccessibilityView="Raw" />
				<Button Classes="contemporary quiet compact" HorizontalAlignment="Right" VerticalAlignment="Top"
						Content="More" Command="{Binding ContextCommand, ElementName=Root}"
						CommandParameter="{Binding ContextCommandParameter, ElementName=Root}"
						IsVisible="{Binding ContextCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"
						AutomationProperties.Name="More book actions" />
			</Grid>
			<StackPanel Grid.Row="1" Spacing="{DynamicResource Libation.Space.1}">
				<TextBlock Text="{Binding Title, ElementName=Root}" FontFamily="{DynamicResource Libation.Font.Display}" FontWeight="SemiBold" FontSize="{DynamicResource Libation.FontSize.BodyStrong}"
						   Foreground="{DynamicResource Libation.Brush.TextPrimary}" TextWrapping="Wrap" MaxLines="2" />
				<TextBlock Text="{Binding Author, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextSecondary}"
						   FontSize="{DynamicResource Libation.FontSize.BodySmall}" TextTrimming="CharacterEllipsis" />
				<TextBlock Text="{Binding Narrator, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextTertiary}"
						   FontSize="{DynamicResource Libation.FontSize.Caption}" TextTrimming="CharacterEllipsis"
						   IsVisible="{Binding Narrator, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
				<TextBlock Text="{Binding Duration, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextTertiary}"
						   FontSize="{DynamicResource Libation.FontSize.Caption}" />
				<components:StatusBadge Status="{Binding Status, ElementName=Root}" TextOverride="{Binding StatusText, ElementName=Root}"
									HorizontalAlignment="Left" />
				<ProgressBar Classes="contemporary" Minimum="0" Maximum="100" Value="{Binding Progress, ElementName=Root}"
							 IsVisible="{Binding ShowProgress, ElementName=Root}" AutomationProperties.Name="Book progress" />
			</StackPanel>
			<Button Grid.Row="2" Classes="contemporary" Content="Open" Command="{Binding Command, ElementName=Root}"
					CommandParameter="{Binding CommandParameter, ElementName=Root}" HorizontalAlignment="Stretch"
					IsVisible="{Binding ShowOpenAction, ElementName=Root}"
					AutomationProperties.Name="{Binding Title, ElementName=Root}" />
		</Grid>
	</Border>
</UserControl>
