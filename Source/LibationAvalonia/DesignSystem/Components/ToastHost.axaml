<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 xmlns:designSystem="using:LibationAvalonia.DesignSystem"
			 x:Class="LibationAvalonia.DesignSystem.Components.ToastHost"
			 x:Name="Root"
			 IsHitTestVisible="True">
	<UserControl.Styles>
		<Style Selector="Border.toast-card">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="RenderTransform" Value="translateY(0px)" />
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Fast}" />
					<TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Fast}" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.toast-card.entering">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="RenderTransform" Value="translateY(8px)" />
		</Style>
		<Style Selector="Border.toast-card.exiting">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="RenderTransform" Value="translateY(-8px)" />
		</Style>
	</UserControl.Styles>
	<ItemsControl ItemsSource="{Binding Presentations, ElementName=Root}"
				  AutomationProperties.Name="Notifications"
				  AutomationProperties.LiveSetting="{x:Static designSystem:PlatformAutomationPolicy.Polite}">
		<ItemsControl.ItemsPanel>
			<ItemsPanelTemplate><StackPanel Spacing="{DynamicResource Libation.Space.2}" /></ItemsPanelTemplate>
		</ItemsControl.ItemsPanel>
		<ItemsControl.DataTemplates>
			<DataTemplate x:DataType="components:ToastPresentation" DataType="{x:Type components:ToastPresentation}">
				<Border Classes="card raised toast-card"
					Classes.entering="{Binding IsEntering}"
					Classes.exiting="{Binding IsExiting}"
					MinWidth="280" MaxWidth="440">
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
						<components:StatusBadge Status="{Binding Message.Status}" />
						<TextBlock Grid.Column="1" Text="{Binding Message.Message}" Foreground="{DynamicResource Libation.Brush.TextPrimary}"
								   TextWrapping="Wrap" VerticalAlignment="Center" />
						<Button Grid.Column="2" Classes="contemporary quiet compact" Content="{Binding Message.ActionText}"
								Command="{Binding Message.ActionCommand}" CommandParameter="{Binding Message.ActionCommandParameter}"
								IsVisible="{Binding Message.ActionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</Grid>
				</Border>
			</DataTemplate>
		</ItemsControl.DataTemplates>
	</ItemsControl>
</UserControl>
