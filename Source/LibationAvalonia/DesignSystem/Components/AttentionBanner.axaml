<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="using:LibationAvalonia.DesignSystem.Components"
			 x:Class="LibationAvalonia.DesignSystem.Components.AttentionBanner"
			 x:Name="Root">
	<UserControl.Styles>
		<Style Selector="components|AttentionBanner Border#BannerRoot"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.BorderStrong}" /></Style>
		<Style Selector="components|AttentionBanner Path#BannerIcon"><Setter Property="Stroke" Value="{DynamicResource Libation.Brush.TextSecondary}" /></Style>
		<Style Selector="components|AttentionBanner:info Border#BannerRoot"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Info}" /></Style>
		<Style Selector="components|AttentionBanner:info Path#BannerIcon"><Setter Property="Data" Value="{DynamicResource status.download-pending}" /><Setter Property="Stroke" Value="{DynamicResource Libation.Brush.Info}" /></Style>
		<Style Selector="components|AttentionBanner:success Border#BannerRoot"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Success}" /></Style>
		<Style Selector="components|AttentionBanner:success Path#BannerIcon"><Setter Property="Data" Value="{DynamicResource status.completed}" /><Setter Property="Stroke" Value="{DynamicResource Libation.Brush.Success}" /></Style>
		<Style Selector="components|AttentionBanner:warning Border#BannerRoot"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Warning}" /></Style>
		<Style Selector="components|AttentionBanner:warning Path#BannerIcon"><Setter Property="Data" Value="{DynamicResource status.needs-attention}" /><Setter Property="Stroke" Value="{DynamicResource Libation.Brush.Warning}" /></Style>
		<Style Selector="components|AttentionBanner:danger Border#BannerRoot"><Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Danger}" /></Style>
		<Style Selector="components|AttentionBanner:danger Path#BannerIcon"><Setter Property="Data" Value="{DynamicResource status.failed}" /><Setter Property="Stroke" Value="{DynamicResource Libation.Brush.Danger}" /></Style>
	</UserControl.Styles>
	<Border x:Name="BannerRoot" Background="{DynamicResource Libation.Brush.SurfaceRaised}" BorderThickness="2,0,0,0"
			CornerRadius="{DynamicResource Libation.Radius.Small}" Padding="{DynamicResource Libation.Density.CardPadding}"
			Focusable="{Binding FocusOnShow, ElementName=Root}"
			AutomationProperties.Name="{Binding Title, ElementName=Root}"
			AutomationProperties.HelpText="{Binding Message, ElementName=Root}"
			AutomationProperties.LiveSetting="Polite">
		<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
			<Path x:Name="BannerIcon" Width="24" Height="24" Stretch="Uniform" StrokeThickness="1.75"
				  StrokeLineCap="Round" StrokeJoin="Round" Data="M12,3 L22,21 H2 Z M12,9 V14 M12,18 V18.1"
				  AutomationProperties.IsControlElementOverride="False" AutomationProperties.AccessibilityView="Raw" />
			<StackPanel Grid.Column="1" Spacing="{DynamicResource Libation.Space.1}">
				<TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold" Foreground="{DynamicResource Libation.Brush.TextPrimary}" />
				<TextBlock Text="{Binding Message, ElementName=Root}" Foreground="{DynamicResource Libation.Brush.TextSecondary}" TextWrapping="Wrap" />
			</StackPanel>
			<Button Grid.Column="2" Classes="contemporary" Content="{Binding ActionText, ElementName=Root}"
					Command="{Binding ActionCommand, ElementName=Root}" CommandParameter="{Binding ActionCommandParameter, ElementName=Root}"
					IsVisible="{Binding ActionText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
			<Button Grid.Column="3" Classes="contemporary quiet" Content="{Binding SecondaryActionText, ElementName=Root}"
					Command="{Binding SecondaryActionCommand, ElementName=Root}" CommandParameter="{Binding SecondaryActionCommandParameter, ElementName=Root}"
					IsVisible="{Binding SecondaryActionText, ElementName=Root, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
			<Button Grid.Column="4" Classes="contemporary quiet compact" Content="Dismiss"
					Command="{Binding DismissCommand, ElementName=Root}" CommandParameter="{Binding DismissCommandParameter, ElementName=Root}"
					IsVisible="{Binding DismissCommand, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}"
					AutomationProperties.Name="Dismiss notification" />
		</Grid>
	</Border>
</UserControl>
