<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:shell="using:LibationAvalonia.Shell"
		xmlns:components="using:LibationAvalonia.DesignSystem.Components"
		xmlns:accounts="using:LibationAvalonia.Features.Accounts"
		xmlns:downloads="using:LibationAvalonia.Features.Downloads"
		xmlns:flight="using:LibationAvalonia.Features.Flight"
		xmlns:history="using:LibationAvalonia.Features.History"
		xmlns:library="using:LibationAvalonia.Features.Library"
		xmlns:overview="using:LibationAvalonia.Features.Overview"
		xmlns:processing="using:LibationAvalonia.Features.Processing"
		xmlns:settings="using:LibationAvalonia.Features.Settings"
		xmlns:tools="using:LibationAvalonia.Features.Tools"
		xmlns:trash="using:LibationAvalonia.Features.Trash"
		xmlns:views="using:LibationAvalonia.Views"
		xmlns:vm="using:LibationAvalonia.ViewModels"
		xmlns:properties="using:LibationAvalonia.Properties"
		x:Class="LibationAvalonia.Shell.AppShellView"
		x:Name="Root"
		x:DataType="shell:AppShellViewModel">
	<UserControl.Styles>
		<Style Selector="Button.nav">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextPrimary}" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource Libation.Radius.Small}" />
		</Style>
		<Style Selector="Button.nav:pointerover">
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceInteractive}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.BorderSubtle}" />
		</Style>
		<Style Selector="Button.nav:pressed">
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.Selection}" />
		</Style>
		<Style Selector="Button.nav:focus-visible">
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Focus}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<Style Selector="Border.nav-item">
			<Setter Property="MinHeight" Value="{DynamicResource Libation.Density.RowHeight}" />
			<Setter Property="Padding" Value="12" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource Libation.Radius.Small}" />
		</Style>
	</UserControl.Styles>
	<UserControl.Resources>
		<DataTemplate x:Key="RouteHeaderAction" x:DataType="shell:RouteCommandPresentation">
			<Button Classes="contemporary" Margin="0,0,8,8"
				Content="{Binding Text}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" />
		</DataTemplate>
	</UserControl.Resources>
	<Grid Background="{DynamicResource Libation.Brush.Canvas}">
		<SplitView x:Name="ShellSplitView"
			DisplayMode="{Binding Layout.NavigationDisplayMode}"
			IsPaneOpen="{Binding Layout.IsNavigationPaneOpen, Mode=OneWay}"
			OpenPaneLength="{DynamicResource Libation.Navigation.WidthExpanded}"
			CompactPaneLength="{DynamicResource Libation.Navigation.WidthCompact}"
			UseLightDismissOverlayMode="True"
			PaneClosing="ShellSplitView_PaneClosing"
			PanePlacement="Left">
			<SplitView.Pane>
			<components:LibationNavigationRail
				x:Name="NavigationRail"
				ItemsSource="{Binding Navigation.PrimaryItems}"
				UtilityItemsSource="{Binding Navigation.UtilityItems}"
				SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
				IsExpanded="{Binding Layout.IsNavigationExpanded}">
			<components:LibationNavigationRail.Transitions>
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Default}" />
				</Transitions>
			</components:LibationNavigationRail.Transitions>
			<components:LibationNavigationRail.BrandContent>
				<Grid Margin="0,4,0,8">
					<Grid IsVisible="{Binding Layout.IsNavigationExpanded}">
						<ContentControl IsVisible="{Binding IsCellarComposition}"
							Template="{DynamicResource brand.wordmark.horizontal.light}" />
						<ContentControl IsVisible="{Binding IsTastingRoomComposition}"
							Template="{DynamicResource brand.wordmark.horizontal.dark}" />
					</Grid>
					<Viewbox Width="32" Height="32" IsVisible="{Binding !Layout.IsNavigationExpanded}">
						<Path Data="{StaticResource brand.mark.one-color}"
							  Stroke="{DynamicResource Libation.Brush.AccentSecondary}"
							  StrokeThickness="1.75"
							  StrokeLineCap="Round"
							  StrokeJoin="Round" />
					</Viewbox>
				</Grid>
			</components:LibationNavigationRail.BrandContent>
			<components:LibationNavigationRail.ItemTemplate>
				<DataTemplate x:DataType="shell:ShellNavigationItemViewModel">
					<Border Classes="nav-item">
						<Grid ColumnDefinitions="24,*" ColumnSpacing="12" Margin="2,5">
							<Path Width="20" Height="20"
							  Stretch="Uniform"
							  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
							  StrokeThickness="1.75"
							  StrokeLineCap="Round"
							  StrokeJoin="Round"
							  Data="{Binding IconData}" />
							<TextBlock Grid.Column="1" Classes="nav-label"
								   VerticalAlignment="Center"
								   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
								   Text="{Binding Label}" />
						</Grid>
					</Border>
				</DataTemplate>
			</components:LibationNavigationRail.ItemTemplate>
		</components:LibationNavigationRail>
			</SplitView.Pane>

		<Grid RowDefinitions="*,Auto,Auto">

		<Grid RowDefinitions="Auto,Auto,Auto,Auto,*" MinWidth="0">
			<Menu Grid.Row="0" IsVisible="{Binding Main.MenuBarVisible}">
				<MenuItem Header="{x:Static properties:Resources.MenuImportHeader}">
					<MenuItem IsVisible="{Binding Main.AnyAccounts}" Command="{Binding Main.ToggleAutoScan}" Header="{x:Static properties:Resources.MenuAutoScanLibraryHeader}">
						<MenuItem.Icon><CheckBox BorderThickness="0" IsChecked="{Binding Main.AutoScanChecked}" IsHitTestVisible="False" /></MenuItem.Icon>
					</MenuItem>
					<MenuItem IsVisible="{Binding !Main.AnyAccounts}" Command="{Binding Main.AddAccountsAsync}" Header="{x:Static properties:Resources.MenuAddAccountHeader}" />
					<MenuItem IsVisible="{Binding Main.OneAccount}" IsEnabled="{Binding !Main.ActivelyScanning}" Command="{Binding Main.ScanAccountAsync}" Header="{x:Static properties:Resources.MenuScanLibraryHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding !Main.ActivelyScanning}" Command="{Binding Main.ScanAllAccountsAsync}" Header="{x:Static properties:Resources.MenuScanAllAccountsHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding !Main.ActivelyScanning}" Command="{Binding Main.ScanSomeAccountsAsync}" Header="{x:Static properties:Resources.MenuScanSomeAccountsHeader}" />
					<Separator IsVisible="{Binding Main.AnyAccounts}" />
					<MenuItem IsVisible="{Binding Main.OneAccount}" IsEnabled="{Binding Main.RemoveMenuItemsEnabled}" Command="{Binding Main.RemoveBooksAsync}" Header="{x:Static properties:Resources.MenuRemoveLibraryBooksHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding Main.RemoveMenuItemsEnabled}" Command="{Binding Main.RemoveBooksAllAsync}" Header="{x:Static properties:Resources.MenuRemoveBooksAllAccountsHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding Main.RemoveMenuItemsEnabled}" Command="{Binding Main.RemoveBooksSomeAsync}" Header="{x:Static properties:Resources.MenuRemoveBooksSomeAccountsHeader}" />
					<Separator />
					<MenuItem Command="{Binding Main.LocateAudiobooksAsync}" Header="{x:Static properties:Resources.MenuLocateAudiobooksHeader}" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuLiberateHeader}">
					<MenuItem Command="{Binding Main.BackupAllBooks}" Header="{Binding Main.BookBackupsToolStripText}" />
					<MenuItem Command="{Binding Main.BackupAllPdfs}" Header="{Binding Main.PdfBackupsToolStripText}" />
					<MenuItem Command="{Binding Main.ConvertAllToMp3Async}" Header="{x:Static properties:Resources.MenuConvertAllM4BToMp3Header}" />
					<MenuItem Command="{Binding Main.LiberateVisible}" Header="{Binding Main.LiberateVisibleToolStripText}" IsEnabled="{Binding Main.AnyVisibleNotLiberated}" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuExportHeader}">
					<MenuItem IsEnabled="{Binding Main.LibraryStats.HasBookResults, TargetNullValue=false}" Command="{Binding Main.ExportLibraryAsync}" Header="{x:Static properties:Resources.MenuExportLibraryHeader}" InputGesture="ctrl+S" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuQuickFiltersHeader}" ItemsSource="{Binding Main.ContemporaryQuickFilterMenuItems}" />
				<MenuItem Header="{Binding Main.VisibleCountMenuItemText}">
					<MenuItem Command="{Binding Main.LiberateVisible}" Header="{Binding Main.LiberateVisibleToolStripText_2}" IsEnabled="{Binding Main.AnyVisibleNotLiberated}" />
					<MenuItem Command="{Binding Main.ReplaceTagsAsync}" Header="{x:Static properties:Resources.MenuReplaceTagsHeader}" />
					<MenuItem Command="{Binding Main.SetBookDownloadedAsync}" Header="{x:Static properties:Resources.MenuSetBookDownloadedHeader}" />
					<MenuItem Command="{Binding Main.SetPdfDownloadedAsync}" Header="{x:Static properties:Resources.MenuSetPdfDownloadedHeader}" />
					<MenuItem Command="{Binding Main.SetDownloadedAutoAsync}" Header="{x:Static properties:Resources.MenuSetDownloadedAutomaticallyHeader}" />
					<MenuItem Command="{Binding Main.RemoveVisibleAsync}" Header="{x:Static properties:Resources.MenuRemoveFromLibraryHeader}" />
				</MenuItem>
				<MenuItem x:Name="ShellSettingsMenu" Header="{x:Static properties:Resources.MenuSettingsHeader}">
					<MenuItem Command="{Binding Main.ShowAccountsAsync}" Header="{x:Static properties:Resources.MenuAccountsHeader}" InputGesture="ctrl+shift+A" />
					<MenuItem Command="{Binding Main.ShowSettingsAsync}" Header="{x:Static properties:Resources.MenuOpenSettingsHeader}" InputGesture="ctrl+P" />
					<Separator />
					<MenuItem Command="{Binding Main.ShowTrashBinAsync}" Header="{Binding Main.TrashBinMenuText}" />
					<MenuItem Command="{Binding Main.LaunchHangover}" Header="{x:Static properties:Resources.MenuLaunchHangoverHeader}" />
					<Separator />
					<MenuItem Command="{Binding Main.ShowFindBetterQualityBooksAsync}" Header="{x:Static properties:Resources.MenuScanForBetterQualityAudiobooksHeader}" />
					<Separator />
					<MenuItem Command="{Binding Main.StartWalkthroughAsync}" Header="{x:Static properties:Resources.MenuReviewContemporarySetupHeader}" />
					<MenuItem Command="{Binding Main.ShowAboutAsync}" Header="{x:Static properties:Resources.MenuAboutHeader}" />
				</MenuItem>
			</Menu>

			<Border x:Name="ShellToolbar" Grid.Row="1"
				Background="{DynamicResource Libation.Brush.SurfaceRaised}"
				BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}"
				BorderThickness="0,0,0,1"
				Padding="{DynamicResource Libation.Thickness.2}">
				<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.2}">
					<Button Classes="contemporary quiet compact"
						IsVisible="{Binding Layout.ShowNavigationCommand}"
						Command="{Binding ToggleNavigationOverlayCommand}"
						Content="Navigation"
						AutomationProperties.Name="{x:Static properties:Resources.ShellOpenPrimaryNavigationAutomationName}" />
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Libation.Space.2}" VerticalAlignment="Center">
						<ProgressBar Width="120" Minimum="0" Maximum="100" Value="{Binding Main.DownloadProgress}"
							IsVisible="{Binding Main.DownloadProgress, Converter={x:Static ObjectConverters.IsNotNull}}"
							AutomationProperties.Name="Application update progress" />
						<TextBlock IsVisible="{Binding Main.ActivelyScanning}" Text="{Binding Main.ScanningText}"
							VerticalAlignment="Center" Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
					</StackPanel>
					<Button Grid.Column="2" Classes="contemporary quiet" Click="SearchShortcut_Click"
						Content="Search Library" AutomationProperties.Name="Search the Library" />
					<Button Grid.Column="3" Classes="contemporary quiet compact"
						Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.Settings}"
						Content="Settings" />
				</Grid>
			</Border>

			<Border x:Name="HeaderRegion" Grid.Row="2"
					IsVisible="{Binding ShowRouteHeader}"
					Background="{DynamicResource Libation.Brush.Surface}"
					BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}"
					BorderThickness="0,0,0,1"
					Padding="{DynamicResource Libation.Thickness.4}">
				<components:PageHeader
					Eyebrow="{Binding CurrentRoutePresentation.RouteEyebrow}"
					Title="{Binding CurrentRoutePresentation.RouteTitle}"
					SupportingText="{Binding CurrentRoutePresentation.RouteSubtitle}"
					PrimaryActionText="{Binding CurrentRoutePresentation.RoutePrimaryCommand.Text}"
					PrimaryCommand="{Binding CurrentRoutePresentation.RoutePrimaryCommand.Command}"
					PrimaryCommandParameter="{Binding CurrentRoutePresentation.RoutePrimaryCommand.Parameter}"
					SecondaryActions="{Binding CurrentRoutePresentation.RouteSecondaryCommands}"
					SecondaryActionTemplate="{StaticResource RouteHeaderAction}">
					<components:PageHeader.StatusContent>
						<components:StatusBadge IsVisible="{Binding HasRouteStatusBadge}"
							Status="{Binding CurrentRoutePresentation.RouteStatusBadge.Status}"
							TextOverride="{Binding CurrentRoutePresentation.RouteStatusBadge.Text}"
							AccessibleName="{Binding CurrentRoutePresentation.RouteStatusBadge.Text}" />
					</components:PageHeader.StatusContent>
				</components:PageHeader>
			</Border>

			<Border Grid.Row="3"
				IsVisible="{Binding Main.RemoveButtonsVisible}"
				Background="{DynamicResource Libation.Brush.SurfaceRaised}"
				BorderBrush="{DynamicResource Libation.Brush.Warning}"
				BorderThickness="0,0,0,1"
				Padding="{DynamicResource Libation.Thickness.3}">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel>
						<TextBlock FontWeight="SemiBold" Text="Review titles removed from the latest account scan" />
						<TextBlock Text="Confirm the checked removals, or finish without removing them." TextWrapping="Wrap" />
					</StackPanel>
					<Button Grid.Column="1" Classes="contemporary danger"
						IsEnabled="{Binding Main.RemoveBooksButtonEnabled}"
						Command="{Binding Main.RemoveBooksBtn}"
						Content="{Binding Main.RemoveBooksButtonText}" />
					<Button Grid.Column="2" Classes="contemporary quiet"
						Command="{Binding Main.DoneRemovingBtn}"
						Content="{x:Static properties:Resources.ShellDoneReviewingCommandLabel}" />
				</Grid>
			</Border>

			<Grid x:Name="ContentRegion" Grid.Row="4" Margin="{DynamicResource Libation.Thickness.4}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.4}"
				Opacity="1" RenderTransform="translateY(0px)">
				<Grid.Transitions>
					<Transitions>
						<DoubleTransition Property="Opacity" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Fast}" />
						<TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Default}" />
					</Transitions>
				</Grid.Transitions>
				<Panel Grid.Column="0">
				<Grid IsVisible="{Binding IsLibraryRoute}">
					<library:LibraryView x:Name="LibraryDisplay"
						DataContext="{Binding Library, Mode=OneTime}"
						LiberateClicked="ProductsDisplay_LiberateClicked"
						TagsButtonClicked="ProductsDisplay_TagsButtonClicked"
						LiberateSeriesClicked="ProductsDisplay_LiberateSeriesClicked"
						ConvertToMp3Clicked="ProductsDisplay_ConvertToMp3Clicked" />
				</Grid>

				<Grid IsVisible="{Binding IsProcessingRoute}">
					<processing:ProcessingView DataContext="{Binding Processing, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsDownloadsRoute}">
					<downloads:DownloadsView DataContext="{Binding Downloads, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsHistoryRoute}">
					<history:HistoryView DataContext="{Binding History, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsAccountsRoute}">
					<accounts:AccountsView DataContext="{Binding Accounts, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsSettingsRoute}">
					<settings:SettingsView DataContext="{Binding Settings, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsToolsRoute}">
					<tools:ToolsView DataContext="{Binding Tools, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsTrashRoute}">
					<trash:TrashView DataContext="{Binding Trash, Mode=OneTime}" />
				</Grid>

					<ContentControl x:Name="OverviewHost" IsVisible="{Binding IsOverviewRoute}" />
				</Panel>
				<Border x:Name="PersistentFlightPane" Grid.Column="1" Width="360" IsVisible="{Binding Layout.ShowPersistentFlight}"
					Background="{DynamicResource Libation.Brush.SurfaceRaised}"
					BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}"
					BorderThickness="1" CornerRadius="{DynamicResource Libation.Radius.Large}"
					Padding="{DynamicResource Libation.Thickness.3}" RenderTransform="translateX(0px)">
					<Border.Transitions>
						<Transitions>
							<TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Default}" />
						</Transitions>
					</Border.Transitions>
					<ContentControl x:Name="PersistentFlightHost" />
				</Border>
				<Border x:Name="FlightOverlay" Grid.Column="0" Grid.ColumnSpan="2" Width="360" HorizontalAlignment="Right"
					ZIndex="10" IsVisible="{Binding Layout.ShowFlightOverlay}"
					Background="{DynamicResource Libation.Brush.SurfaceRaised}"
					BorderBrush="{DynamicResource Libation.Brush.BorderStrong}"
					BorderThickness="1" CornerRadius="{DynamicResource Libation.Radius.Large}"
					Padding="{DynamicResource Libation.Thickness.3}" RenderTransform="translateX(0px)">
					<Border.Transitions>
						<Transitions>
							<TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Default}" />
						</Transitions>
					</Border.Transitions>
					<ContentControl x:Name="FlightOverlayHost" />
				</Border>
			</Grid>
		</Grid>

		<ContentControl x:Name="QueueDock" Grid.Row="1"
			Margin="{DynamicResource Libation.Thickness.3}"
			IsVisible="{Binding Layout.ShowQueueDock}" />

		<components:ShellStatusBar x:Name="ShellStatusBar" Grid.Row="2"
			VisibleText="{Binding Library.ResultStateText}"
			SelectedText="{Binding Library.SelectionStateText}"
			TrashText="{Binding Main.TrashBinStatusText}"
			FlightText="{Binding Flight.Count, StringFormat={x:Static properties:Resources.ShellCurrentFlightCountFormat}}"
			QueueText="{Binding Processing.SummaryText}"
			ScanText="{Binding Main.ScanningText}"
			UpdateText="{Binding Main.ApplicationUpdateState}"
			UpgradeProgress="{Binding Main.DownloadProgress}"
			IsScanning="{Binding Main.ActivelyScanning}"
			ShowFlight="{Binding Layout.ShowFlightToggle}"
			HasUpdateAvailable="{Binding HasUpdateAvailable}"
			FlightCommand="{Binding ToggleFlightCommand}"
			QueueCommand="{Binding ToggleDecanterDrawerCommand}"
			UpdateCommand="{Binding Settings.OpenAboutCommand}" />

		<Button ZIndex="40"
			IsVisible="{Binding Layout.ShowDecanterDrawer}"
			Command="{Binding CloseDecanterDrawerCommand}"
			Background="{DynamicResource Libation.Brush.Canvas}"
			Opacity="0.72"
			AutomationProperties.Name="{x:Static properties:Resources.ShellCloseProcessingDrawerAutomationName}" />
		<Border x:Name="DecanterDrawer" ZIndex="50"
			IsVisible="{Binding Layout.ShowDecanterDrawer}"
			HorizontalAlignment="Right"
			VerticalAlignment="Stretch"
			MaxWidth="{DynamicResource Libation.Content.MaxReadingWidth}"
			Margin="{DynamicResource Libation.Thickness.4}"
			Padding="{DynamicResource Libation.Thickness.4}"
			Background="{DynamicResource Libation.Brush.SurfaceRaised}"
			BorderBrush="{DynamicResource Libation.Brush.BorderStrong}"
			BorderThickness="1"
			CornerRadius="{DynamicResource Libation.Radius.Large}"
			RenderTransform="translateX(0px)">
			<Border.Transitions>
				<Transitions>
					<TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource Libation.Motion.EffectiveDuration.Default}" />
				</Transitions>
			</Border.Transitions>
			<Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Libation.Space.3}">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Text="Processing summary" FontFamily="{DynamicResource Libation.Font.Display}"
						FontSize="{DynamicResource Libation.FontSize.Section}" />
					<Button Grid.Column="1" Classes="contemporary quiet compact"
						Command="{Binding CloseDecanterDrawerCommand}"
						Content="{x:Static properties:Resources.ShellCloseCommandLabel}" />
				</Grid>
				<StackPanel Grid.Row="1" Spacing="{DynamicResource Libation.Space.3}">
					<ContentControl x:Name="DecanterDrawerHost" />
				</StackPanel>
			</Grid>
		</Border>
		<Panel x:Name="SurfaceParkingHost" IsVisible="False">
			<ContentControl x:Name="FlightParkingHost">
				<flight:CurrentFlightView x:Name="SharedFlightSurface" />
			</ContentControl>
			<ContentControl x:Name="DecanterParkingHost">
			<components:DecanterSummary x:Name="SharedDecanterSurface"
				SummaryText="{Binding Processing.SummaryText}"
				IsCellar="{Binding IsCellarComposition}"
				IsTastingRoom="{Binding IsTastingRoomComposition}"
				HasWork="{Binding Processing.CanCancel}"
				IsIdle="{Binding !Processing.CanCancel}"
				ActiveItems="{Binding Processing.DecanterActiveItems}"
				InQueueText="{Binding Processing.InQueueText}"
				ConvertingText="{Binding Processing.ConvertingText}"
				RunningTimeText="{Binding Processing.RunningTimeText}"
				CurrentTitle="{Binding Processing.CurrentTitle}"
				CurrentStageText="{Binding Processing.CurrentStage}"
				CurrentOutputText="{Binding Processing.CurrentItem.OutputProfileText}"
				Progress="{Binding Processing.CurrentProgress}"
				ProgressText="{Binding Processing.CurrentItem.ProgressText}"
				ProgressAccessibleName="{Binding Processing.CurrentItem.ProgressAccessibleName}"
				ShowProgress="{Binding Processing.ShowCurrentProgress}"
				CancelCommand="{Binding Processing.CurrentCancelCommand}"
				CanCancel="{Binding Processing.CurrentCancellable}"
				CancelAccessibleName="{Binding Processing.CurrentItem.CancelAccessibleName}"
				OpenProcessingCommand="{Binding NavigateCommand}"
				OpenProcessingCommandParameter="{x:Static shell:AppRouteId.Processing}" />
			</ContentControl>
		</Panel>
		<components:ToastHost Grid.RowSpan="3" ZIndex="60"
			HorizontalAlignment="Right" VerticalAlignment="Bottom"
			Margin="{DynamicResource Libation.Thickness.4}"
			ItemsSource="{Binding CurrentFlight.Notifications}" />
		</Grid>
		</SplitView>
	</Grid>
</UserControl>
