<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:shell="using:LibationAvalonia.Shell"
		xmlns:components="using:LibationAvalonia.DesignSystem.Components"
		xmlns:accounts="using:LibationAvalonia.Features.Accounts"
		xmlns:downloads="using:LibationAvalonia.Features.Downloads"
		xmlns:flight="using:LibationAvalonia.Features.Flight"
		xmlns:history="using:LibationAvalonia.Features.History"
		xmlns:library="using:LibationAvalonia.Features.Library"
		xmlns:overview="using:LibationAvalonia.Features.Overview"
		xmlns:processing="using:LibationAvalonia.Features.Processing"
		xmlns:settings="using:LibationAvalonia.Features.Settings"
		xmlns:tools="using:LibationAvalonia.Features.Tools"
		xmlns:trash="using:LibationAvalonia.Features.Trash"
		xmlns:views="using:LibationAvalonia.Views"
		xmlns:vm="using:LibationAvalonia.ViewModels"
		xmlns:properties="using:LibationAvalonia.Properties"
		x:Class="LibationAvalonia.Shell.AppShellView"
		x:Name="Root"
		x:DataType="shell:AppShellViewModel">
	<UserControl.Styles>
		<Style Selector="Button.nav">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Libation.Brush.TextPrimary}" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource Libation.Radius.Small}" />
		</Style>
		<Style Selector="Button.nav:pointerover">
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.SurfaceInteractive}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.BorderSubtle}" />
		</Style>
		<Style Selector="Button.nav:pressed">
			<Setter Property="Background" Value="{DynamicResource Libation.Brush.Selection}" />
		</Style>
		<Style Selector="Button.nav:focus-visible">
			<Setter Property="BorderBrush" Value="{DynamicResource Libation.Brush.Focus}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<Style Selector="Border.nav-item">
			<Setter Property="MinHeight" Value="{DynamicResource Libation.Density.RowHeight}" />
			<Setter Property="Padding" Value="12" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource Libation.Radius.Small}" />
		</Style>
	</UserControl.Styles>
	<Grid Background="{DynamicResource Libation.Brush.Canvas}"
		  RowDefinitions="*,Auto,Auto">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="{Binding NavigationColumnWidth}" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<!-- The rail spans both columns so it can become an overlay. Spanning
		     children do not size an Auto column, so reserve the inline rail's
		     design-token width explicitly in expanded and compact layouts. -->
		<Border Grid.RowSpan="3"
			Width="{DynamicResource Libation.Navigation.WidthExpanded}"
			IsVisible="{Binding IsRailExpanded}"
			IsHitTestVisible="False" />
		<Border Grid.RowSpan="3"
			Width="{DynamicResource Libation.Navigation.WidthCompact}"
			IsVisible="{Binding IsRailCompact}"
			IsHitTestVisible="False" />
		<Button Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="20"
			IsVisible="{Binding ShowNavigationScrim}"
			Command="{Binding CloseNavigationOverlayCommand}"
			Background="{DynamicResource Libation.Brush.Canvas}"
			Opacity="0.72"
			AutomationProperties.Name="{x:Static properties:Resources.ShellCloseNavigationOverlayAutomationName}" />
		<components:LibationNavigationRail
			x:Name="NavigationRail"
			Grid.RowSpan="3"
			Grid.ColumnSpan="2"
			ZIndex="30"
			HorizontalAlignment="Left"
			IsVisible="{Binding IsNavigationRailVisible}"
			ItemsSource="{Binding Navigation.PrimaryItems}"
			SelectedItem="{Binding SelectedPrimaryItem, Mode=TwoWay}"
			IsExpanded="{Binding IsNavigationRailExpanded}">
			<components:LibationNavigationRail.BrandContent>
				<Grid Margin="0,4,0,8">
					<ContentControl IsVisible="{Binding IsNavigationRailExpanded}"
						Template="{DynamicResource brand.wordmark.horizontal.light}" />
					<Viewbox Width="32" Height="32" IsVisible="{Binding !IsNavigationRailExpanded}">
						<Path Data="{StaticResource brand.mark.one-color}"
							  Stroke="{DynamicResource Libation.Brush.AccentSecondary}"
							  StrokeThickness="1.75"
							  StrokeLineCap="Round"
							  StrokeJoin="Round" />
					</Viewbox>
				</Grid>
			</components:LibationNavigationRail.BrandContent>
			<components:LibationNavigationRail.ItemTemplate>
				<DataTemplate x:DataType="shell:ShellNavigationItemViewModel">
					<Border Classes="nav-item" Background="{Binding SelectionBackground}">
						<Grid ColumnDefinitions="24,*" ColumnSpacing="12" Margin="2,5">
							<Path Width="20" Height="20"
							  Stretch="Uniform"
							  Stroke="{DynamicResource Libation.Brush.TextPrimary}"
							  StrokeThickness="1.75"
							  StrokeLineCap="Round"
							  StrokeJoin="Round"
							  Data="{Binding IconData}" />
							<TextBlock Grid.Column="1"
								   VerticalAlignment="Center"
								   Text="{Binding Label}" />
						</Grid>
					</Border>
				</DataTemplate>
			</components:LibationNavigationRail.ItemTemplate>
			<components:LibationNavigationRail.FooterContent>
				<StackPanel Spacing="4">
					<Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.Accounts}" ToolTip.Tip="{x:Static properties:Resources.RouteAccountsLabel}" AutomationProperties.Name="{x:Static properties:Resources.RouteAccountsLabel}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Path Width="20" Height="20" Data="{StaticResource glyph.accounts}" Stroke="{DynamicResource Libation.Brush.TextPrimary}" StrokeThickness="1.75" />
							<TextBlock IsVisible="{Binding IsNavigationRailExpanded}" Text="{x:Static properties:Resources.RouteAccountsLabel}" />
						</StackPanel>
					</Button>
					<Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.Settings}" ToolTip.Tip="{x:Static properties:Resources.RouteSettingsLabel}" AutomationProperties.Name="{x:Static properties:Resources.RouteSettingsLabel}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Path Width="20" Height="20" Data="{StaticResource glyph.settings}" Stroke="{DynamicResource Libation.Brush.TextPrimary}" StrokeThickness="1.75" />
							<TextBlock IsVisible="{Binding IsNavigationRailExpanded}" Text="{x:Static properties:Resources.RouteSettingsLabel}" />
						</StackPanel>
					</Button>
					<Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.Tools}" ToolTip.Tip="{x:Static properties:Resources.RouteToolsLabel}" AutomationProperties.Name="{x:Static properties:Resources.RouteToolsLabel}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Path Width="20" Height="20" Data="{StaticResource glyph.tools}" Stroke="{DynamicResource Libation.Brush.TextPrimary}" StrokeThickness="1.75" />
							<TextBlock IsVisible="{Binding IsNavigationRailExpanded}" Text="{x:Static properties:Resources.RouteToolsLabel}" />
						</StackPanel>
					</Button>
					<Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.Trash}" ToolTip.Tip="{x:Static properties:Resources.RouteTrashLabel}" AutomationProperties.Name="{x:Static properties:Resources.RouteTrashLabel}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Path Width="20" Height="20" Data="{StaticResource glyph.trash}" Stroke="{DynamicResource Libation.Brush.TextPrimary}" StrokeThickness="1.75" />
							<TextBlock IsVisible="{Binding IsNavigationRailExpanded}" Text="{x:Static properties:Resources.RouteTrashLabel}" />
						</StackPanel>
					</Button>
					<Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.About}" ToolTip.Tip="{x:Static properties:Resources.RouteAboutLabel}" AutomationProperties.Name="{x:Static properties:Resources.ShellAboutPageTitle}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Path Width="20" Height="20" Data="{StaticResource brand.mark.one-color}" Stroke="{DynamicResource Libation.Brush.TextPrimary}" StrokeThickness="1.75" />
							<TextBlock IsVisible="{Binding IsNavigationRailExpanded}" Text="{x:Static properties:Resources.RouteAboutLabel}" />
						</StackPanel>
					</Button>
				</StackPanel>
			</components:LibationNavigationRail.FooterContent>
		</components:LibationNavigationRail>

		<Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" MinWidth="0">
			<Menu Grid.Row="0" IsVisible="{Binding Main.MenuBarVisible}">
				<MenuItem Header="{x:Static properties:Resources.MenuImportHeader}">
					<MenuItem IsVisible="{Binding Main.AnyAccounts}" Command="{Binding Main.ToggleAutoScan}" Header="{x:Static properties:Resources.MenuAutoScanLibraryHeader}">
						<MenuItem.Icon><CheckBox BorderThickness="0" IsChecked="{Binding Main.AutoScanChecked}" IsHitTestVisible="False" /></MenuItem.Icon>
					</MenuItem>
					<MenuItem IsVisible="{Binding !Main.AnyAccounts}" Command="{Binding Main.AddAccountsAsync}" Header="{x:Static properties:Resources.MenuAddAccountHeader}" />
					<MenuItem IsVisible="{Binding Main.OneAccount}" IsEnabled="{Binding !Main.ActivelyScanning}" Command="{Binding Main.ScanAccountAsync}" Header="{x:Static properties:Resources.MenuScanLibraryHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding !Main.ActivelyScanning}" Command="{Binding Main.ScanAllAccountsAsync}" Header="{x:Static properties:Resources.MenuScanAllAccountsHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding !Main.ActivelyScanning}" Command="{Binding Main.ScanSomeAccountsAsync}" Header="{x:Static properties:Resources.MenuScanSomeAccountsHeader}" />
					<Separator IsVisible="{Binding Main.AnyAccounts}" />
					<MenuItem IsVisible="{Binding Main.OneAccount}" IsEnabled="{Binding Main.RemoveMenuItemsEnabled}" Command="{Binding Main.RemoveBooksAsync}" Header="{x:Static properties:Resources.MenuRemoveLibraryBooksHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding Main.RemoveMenuItemsEnabled}" Command="{Binding Main.RemoveBooksAllAsync}" Header="{x:Static properties:Resources.MenuRemoveBooksAllAccountsHeader}" />
					<MenuItem IsVisible="{Binding Main.MultipleAccounts}" IsEnabled="{Binding Main.RemoveMenuItemsEnabled}" Command="{Binding Main.RemoveBooksSomeAsync}" Header="{x:Static properties:Resources.MenuRemoveBooksSomeAccountsHeader}" />
					<Separator />
					<MenuItem Command="{Binding Main.LocateAudiobooksAsync}" Header="{x:Static properties:Resources.MenuLocateAudiobooksHeader}" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuLiberateHeader}">
					<MenuItem Command="{Binding Main.BackupAllBooks}" Header="{Binding Main.BookBackupsToolStripText}" />
					<MenuItem Command="{Binding Main.BackupAllPdfs}" Header="{Binding Main.PdfBackupsToolStripText}" />
					<MenuItem Command="{Binding Main.ConvertAllToMp3Async}" Header="{x:Static properties:Resources.MenuConvertAllM4BToMp3Header}" />
					<MenuItem Command="{Binding Main.LiberateVisible}" Header="{Binding Main.LiberateVisibleToolStripText}" IsEnabled="{Binding Main.AnyVisibleNotLiberated}" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuExportHeader}">
					<MenuItem IsEnabled="{Binding Main.LibraryStats.HasBookResults, TargetNullValue=false}" Command="{Binding Main.ExportLibraryAsync}" Header="{x:Static properties:Resources.MenuExportLibraryHeader}" InputGesture="ctrl+S" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuQuickFiltersHeader}" ItemsSource="{Binding Main.ContemporaryQuickFilterMenuItems}" />
				<MenuItem Header="{Binding Main.VisibleCountMenuItemText}">
					<MenuItem Command="{Binding Main.LiberateVisible}" Header="{Binding Main.LiberateVisibleToolStripText_2}" IsEnabled="{Binding Main.AnyVisibleNotLiberated}" />
					<MenuItem Command="{Binding Main.ReplaceTagsAsync}" Header="{x:Static properties:Resources.MenuReplaceTagsHeader}" />
					<MenuItem Command="{Binding Main.SetBookDownloadedAsync}" Header="{x:Static properties:Resources.MenuSetBookDownloadedHeader}" />
					<MenuItem Command="{Binding Main.SetPdfDownloadedAsync}" Header="{x:Static properties:Resources.MenuSetPdfDownloadedHeader}" />
					<MenuItem Command="{Binding Main.SetDownloadedAutoAsync}" Header="{x:Static properties:Resources.MenuSetDownloadedAutomaticallyHeader}" />
					<MenuItem Command="{Binding Main.RemoveVisibleAsync}" Header="{x:Static properties:Resources.MenuRemoveFromLibraryHeader}" />
				</MenuItem>
				<MenuItem Header="{x:Static properties:Resources.MenuSettingsHeader}">
					<MenuItem Command="{Binding Main.ShowAccountsAsync}" Header="{x:Static properties:Resources.MenuAccountsHeader}" InputGesture="ctrl+shift+A" />
					<MenuItem Command="{Binding Main.ShowSettingsAsync}" Header="{x:Static properties:Resources.MenuOpenSettingsHeader}" InputGesture="ctrl+P" />
					<Separator />
					<MenuItem Command="{Binding Main.ShowTrashBinAsync}" Header="{Binding Main.TrashBinMenuText}" />
					<MenuItem Command="{Binding Main.LaunchHangover}" Header="{x:Static properties:Resources.MenuLaunchHangoverHeader}" />
					<Separator />
					<MenuItem Command="{Binding Main.ShowFindBetterQualityBooksAsync}" Header="{x:Static properties:Resources.MenuScanForBetterQualityAudiobooksHeader}" />
					<Separator />
					<MenuItem Command="{Binding Main.StartWalkthroughAsync}" Header="{x:Static properties:Resources.MenuReviewContemporarySetupHeader}" />
					<MenuItem Command="{Binding Main.ShowAboutAsync}" Header="{x:Static properties:Resources.MenuAboutHeader}" />
				</MenuItem>
			</Menu>

			<Border x:Name="HeaderRegion" Grid.Row="1"
					IsVisible="{Binding !IsOverviewRoute}"
					Background="{DynamicResource Libation.Brush.Surface}"
					BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}"
					BorderThickness="0,0,0,1"
					Padding="{DynamicResource Libation.Thickness.4}">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
					<Button Classes="contemporary quiet compact"
						IsVisible="{Binding IsRailOverlay}"
						Command="{Binding ToggleNavigationOverlayCommand}"
						Content="{x:Static properties:Resources.ShellNavigationCommandLabel}"
						AutomationProperties.Name="{x:Static properties:Resources.ShellOpenPrimaryNavigationAutomationName}" />
					<StackPanel Grid.Column="1">
						<TextBlock FontFamily="{DynamicResource Libation.Font.Display}"
								   FontSize="{DynamicResource Libation.FontSize.Section}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource Libation.Brush.TextPrimary}"
								   Text="{Binding CurrentRoute.Label}" />
						<TextBlock FontSize="{DynamicResource Libation.FontSize.BodySmall}"
								   Foreground="{DynamicResource Libation.Brush.TextSecondary}"
								   Text="{Binding CurrentRoute.AccessibleDescription}" />
					</StackPanel>
					<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<Border IsVisible="{Binding Main.ActivelyScanning}"
								Padding="10,5"
								Background="{DynamicResource Libation.Brush.Info}"
								CornerRadius="{DynamicResource Libation.Radius.Small}">
							<TextBlock Foreground="{DynamicResource Libation.Brush.TextOnAccent}" Text="{Binding Main.ScanningText}" />
						</Border>
						<Button Command="{Binding NavigateCommand}" CommandParameter="{x:Static shell:AppRouteId.Settings}" Content="{x:Static properties:Resources.RouteSettingsLabel}" />
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="2"
				IsVisible="{Binding Main.RemoveButtonsVisible}"
				Background="{DynamicResource Libation.Brush.SurfaceRaised}"
				BorderBrush="{DynamicResource Libation.Brush.Warning}"
				BorderThickness="0,0,0,1"
				Padding="{DynamicResource Libation.Thickness.3}">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource Libation.Space.3}">
					<StackPanel>
						<TextBlock FontWeight="SemiBold" Text="Review titles removed from the latest account scan" />
						<TextBlock Text="Confirm the checked removals, or finish without removing them." TextWrapping="Wrap" />
					</StackPanel>
					<Button Grid.Column="1" Classes="contemporary danger"
						IsEnabled="{Binding Main.RemoveBooksButtonEnabled}"
						Command="{Binding Main.RemoveBooksBtn}"
						Content="{Binding Main.RemoveBooksButtonText}" />
					<Button Grid.Column="2" Classes="contemporary quiet"
						Command="{Binding Main.DoneRemovingBtn}"
						Content="{x:Static properties:Resources.ShellDoneReviewingCommandLabel}" />
				</Grid>
			</Border>

			<Grid x:Name="ContentRegion" Grid.Row="3" Margin="{DynamicResource Libation.Thickness.4}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Libation.Space.4}">
			<Panel Grid.Column="0">
				<Grid IsVisible="{Binding IsLibraryRoute}">
					<library:LibraryView x:Name="LibraryDisplay"
						DataContext="{Binding Library, Mode=OneTime}"
						LiberateClicked="ProductsDisplay_LiberateClicked"
						TagsButtonClicked="ProductsDisplay_TagsButtonClicked"
						LiberateSeriesClicked="ProductsDisplay_LiberateSeriesClicked"
						ConvertToMp3Clicked="ProductsDisplay_ConvertToMp3Clicked" />
				</Grid>

				<Grid IsVisible="{Binding IsProcessingRoute}">
					<processing:ProcessingView DataContext="{Binding Processing, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsDownloadsRoute}">
					<downloads:DownloadsView DataContext="{Binding Downloads, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsHistoryRoute}">
					<history:HistoryView DataContext="{Binding History, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsAccountsRoute}">
					<accounts:AccountsView DataContext="{Binding Accounts, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsSettingsRoute}">
					<settings:SettingsView DataContext="{Binding Settings, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsToolsRoute}">
					<tools:ToolsView DataContext="{Binding Tools, Mode=OneTime}" />
				</Grid>

				<Grid IsVisible="{Binding IsTrashRoute}">
					<trash:TrashView DataContext="{Binding Trash, Mode=OneTime}" />
				</Grid>

				<ScrollViewer IsVisible="{Binding IsAboutRoute}">
					<StackPanel Spacing="16" MaxWidth="900">
						<components:PageHeader Title="{x:Static properties:Resources.ShellAboutPageTitle}" SupportingText="{x:Static properties:Resources.ShellAboutPageDescription}" />
						<Button HorizontalAlignment="Left" Content="{x:Static properties:Resources.ShellOpenAboutCommandLabel}" Command="{Binding Settings.OpenAboutCommand}" />
					</StackPanel>
				</ScrollViewer>

				<Grid IsVisible="{Binding IsOverviewRoute}">
					<Grid IsVisible="{Binding IsCellarComposition}">
						<overview:CellarOverviewView Library="{Binding DataContext.Library, ElementName=Root, Mode=OneTime}"
							DataContext="{Binding Dashboard, Mode=OneTime}" />
					</Grid>
					<Grid IsVisible="{Binding !IsCellarComposition}">
						<overview:TastingRoomOverviewView DataContext="{Binding Dashboard, Mode=OneTime}" />
					</Grid>
				</Grid>
			</Panel>
			<Border x:Name="PersistentFlightPane" Grid.Column="1" Width="360" IsVisible="{Binding ShowPersistentFlightPane}"
					Background="{DynamicResource Libation.Brush.SurfaceRaised}"
					BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}"
					BorderThickness="1" CornerRadius="{DynamicResource Libation.Radius.Large}"
					Padding="{DynamicResource Libation.Thickness.3}">
				<flight:CurrentFlightView DataContext="{Binding CurrentFlight, Mode=OneTime}" />
			</Border>
			<Border x:Name="FlightOverlay" Grid.Column="0" Grid.ColumnSpan="2" Width="360" HorizontalAlignment="Right"
					ZIndex="10" IsVisible="{Binding ShowFlightOverlay}"
					Background="{DynamicResource Libation.Brush.SurfaceRaised}"
					BorderBrush="{DynamicResource Libation.Brush.BorderStrong}"
					BorderThickness="1" CornerRadius="{DynamicResource Libation.Radius.Large}"
					Padding="{DynamicResource Libation.Thickness.3}">
				<flight:CurrentFlightView DataContext="{Binding CurrentFlight, Mode=OneTime}" />
			</Border>
			</Grid>
		</Grid>

		<components:DecanterSummary x:Name="QueueDock" Grid.Row="1" Grid.Column="1"
			Margin="{DynamicResource Libation.Thickness.3}"
			IsVisible="{Binding ShowQueueDock}"
			Title="The Decanter"
			SummaryText="{Binding Processing.SummaryText}"
			ActiveText="{Binding Processing.ActiveText}"
			Progress="{Binding Processing.Progress}"
			ShowProgress="{Binding Processing.ShowProgress}"
			CancelCommand="{Binding Processing.CancelAllCommand}"
			CanCancel="{Binding Processing.CanCancel}">
			<components:DecanterSummary.IllustrationContent>
				<Image Width="120" Height="92" Stretch="Uniform"
					Source="/Assets/ContemporaryCellar/decanter-cellar.png" />
			</components:DecanterSummary.IllustrationContent>
			<components:DecanterSummary.DetailsContent>
				<Button Classes="contemporary quiet" HorizontalAlignment="Left"
					Command="{Binding NavigateCommand}"
					CommandParameter="{x:Static shell:AppRouteId.Processing}"
					Content="{x:Static properties:Resources.ShellOpenProcessingWorkspaceCommandLabel}" />
			</components:DecanterSummary.DetailsContent>
		</components:DecanterSummary>

		<Border x:Name="ShellStatusBar" Grid.Row="2" Grid.Column="1"
				Background="{DynamicResource Libation.Brush.SurfaceRaised}"
				BorderBrush="{DynamicResource Libation.Brush.BorderSubtle}"
				BorderThickness="0,1,0,0"
				Padding="12,6">
			<Panel>
				<Grid IsVisible="{Binding !IsQueueCompact}"
					ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
					<TextBlock VerticalAlignment="Center" Text="{Binding Main.VisibleCountText}" />
					<TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Main.LibraryStats.StatusString}" />
					<Button Grid.Column="2" IsVisible="{Binding ShowFlightToggle}"
							Command="{Binding ToggleFlightCommand}"
							Content="{Binding Flight.Count, StringFormat={x:Static properties:Resources.ShellCurrentFlightCountFormat}}" />
					<Button Grid.Column="3"
							Command="{Binding ToggleDecanterDrawerCommand}"
							Content="{Binding Processing.SummaryText}"
							AutomationProperties.Name="{x:Static properties:Resources.ShellOpenProcessingSummaryAutomationName}" />
				</Grid>
				<Grid IsVisible="{Binding IsQueueCompact}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
					<Button IsVisible="{Binding ShowFlightToggle}"
						Command="{Binding ToggleFlightCommand}"
						Content="{Binding Flight.Count, StringFormat={x:Static properties:Resources.ShellCompactFlightCountFormat}}"
						AutomationProperties.Name="{x:Static properties:Resources.ShellOpenCurrentFlightAutomationName}" />
					<Button Grid.Column="1" MinHeight="64"
						Command="{Binding ToggleDecanterDrawerCommand}"
						AutomationProperties.Name="{x:Static properties:Resources.ShellOpenCompactProcessingBarAutomationName}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
							<Path Width="24" Height="24" VerticalAlignment="Center"
								Data="{StaticResource glyph.processing}"
								Stroke="{DynamicResource Libation.Brush.TextPrimary}"
								StrokeThickness="1.75" />
							<StackPanel Grid.Column="1">
								<TextBlock Text="The Decanter" FontWeight="SemiBold" />
								<TextBlock Text="{Binding Processing.SummaryText}"
									TextTrimming="CharacterEllipsis"
									Foreground="{DynamicResource Libation.Brush.TextSecondary}" />
							</StackPanel>
							<ProgressBar Grid.Column="2" VerticalAlignment="Center"
								Minimum="0" Maximum="100"
								Value="{Binding Processing.Progress}"
								IsVisible="{Binding Processing.ShowProgress}"
								AutomationProperties.Name="Overall processing progress" />
						</Grid>
					</Button>
				</Grid>
			</Panel>
		</Border>

		<Button Grid.Column="1" ZIndex="40"
			IsVisible="{Binding ShowDecanterDrawer}"
			Command="{Binding CloseDecanterDrawerCommand}"
			Background="{DynamicResource Libation.Brush.Canvas}"
			Opacity="0.72"
			AutomationProperties.Name="{x:Static properties:Resources.ShellCloseProcessingDrawerAutomationName}" />
		<Border x:Name="DecanterDrawer" Grid.Column="1" ZIndex="50"
			IsVisible="{Binding ShowDecanterDrawer}"
			HorizontalAlignment="Right"
			VerticalAlignment="Stretch"
			MaxWidth="{DynamicResource Libation.Content.MaxReadingWidth}"
			Margin="{DynamicResource Libation.Thickness.4}"
			Padding="{DynamicResource Libation.Thickness.4}"
			Background="{DynamicResource Libation.Brush.SurfaceRaised}"
			BorderBrush="{DynamicResource Libation.Brush.BorderStrong}"
			BorderThickness="1"
			CornerRadius="{DynamicResource Libation.Radius.Large}">
			<Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Libation.Space.3}">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Text="Processing summary" FontFamily="{DynamicResource Libation.Font.Display}"
						FontSize="{DynamicResource Libation.FontSize.Section}" />
					<Button Grid.Column="1" Classes="contemporary quiet compact"
						Command="{Binding CloseDecanterDrawerCommand}"
						Content="{x:Static properties:Resources.ShellCloseCommandLabel}" />
				</Grid>
				<StackPanel Grid.Row="1" Spacing="{DynamicResource Libation.Space.3}">
					<components:DecanterSummary
						Title="The Decanter"
						SummaryText="{Binding Processing.SummaryText}"
						ActiveText="{Binding Processing.ActiveText}"
						Progress="{Binding Processing.Progress}"
						ShowProgress="{Binding Processing.ShowProgress}"
						CancelCommand="{Binding Processing.CancelAllCommand}"
						CanCancel="{Binding Processing.CanCancel}" />
					<Button Classes="contemporary primary" HorizontalAlignment="Left"
						Command="{Binding NavigateCommand}"
						CommandParameter="{x:Static shell:AppRouteId.Processing}"
						Content="{x:Static properties:Resources.ShellOpenProcessingWorkspaceCommandLabel}" />
				</StackPanel>
			</Grid>
		</Border>
		<components:ToastHost Grid.Column="1" Grid.RowSpan="3" ZIndex="60"
			HorizontalAlignment="Right" VerticalAlignment="Bottom"
			Margin="{DynamicResource Libation.Thickness.4}"
			ItemsSource="{Binding CurrentFlight.Notifications}" />
	</Grid>
</UserControl>
